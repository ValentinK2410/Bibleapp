:"ἁγίων","t":"hagiōn","r":"святые","s":"G0040"},{"o":"ἀναπέπαυται","t":"anapepautai","r":"имеют был рефрешед","s":"G0373"},{"o":"διὰ","t":"dia","r":"через","s":"G1223"},{"o":"σοῦ,","t":"sou","r":"тебя,","s":"G4771"},{"o":"ἀδελφέ.¶","t":"adelphe","r":"брат.","s":"G0080"}]},{"number":8,"text":"Посему, имея великое во Христе дерзновение приказывать тебе, что должно,","words":[{"o":"Διὸ","t":"Dio","r":"Потому","s":"G1352"},{"o":"πολλὴν","t":"pollēn","r":"много","s":"G4183"},{"o":"ἐν","t":"en","r":"в","s":"G1722"},{"o":"Χριστῷ","t":"Christō","r":"Христос","s":"G5547"},{"o":"παρρησίαν","t":"parrēsian","r":"болднесс","s":"G3954"},{"o":"ἔχων","t":"echōn","r":"имея","s":"G2192"},{"o":"ἐπιτάσσειν","t":"epitassein","r":"к повелеть","s":"G2004"},{"o":"σοι","t":"soi","r":"ты","s":"G4771"},{"o":"τὸ","t":"to","r":"что есть","s":"G3588"},{"o":"ἀνῆκον","t":"anēkon","r":"бефиттинг","s":"G0433"}]},{"number":9,"text":"по любви лучше прошу, не иной кто, как я, Павел старец, а теперь и узник Иисуса Христа;","words":[{"o":"διὰ","t":"dia","r":"для ради","s":"G1223"},{"o":"τὴν","t":"tēn","r":"","s":"G3588"},{"o":"ἀγάπην","t":"agapēn","r":"любовь","s":"G0026"},{"o":"μᾶλλον","t":"mallon","r":"скорее","s":"G3123"},{"o":"παρακαλῶ,","t":"parakalō","r":"я ексхорт ты,","s":"G3870"},{"o":"τοιοῦτος","t":"toioutos","r":"такой один","s":"G5108"},{"o":"ὢν","t":"ōn","r":"будучи","s":"G1510"},{"o":"ὡς","t":"hōs","r":"как","s":"G5613"},{"o":"Παῦλος","t":"Paulos","r":"Павел","s":"G3972"},{"o":"πρεσβύτης","t":"presbutēs","r":"агед","s":"G4246"},{"o":"νυνὶ","t":"nuni","r":"ныне","s":"G3570"},{"o":"δὲ","t":"de","r":"тогда","s":"G1161"},{"o":"καὶ","t":"kai","r":"также","s":"G2532"},{"o":"δέσμιος","t":"desmios","r":"присонер","s":"G1198"},{"o":"Χριστοῦ","t":"Christou","r":"Христос","s":"G5547"},{"o":"Ἰησοῦ·","t":"Iēsou","r":"Иисус;","s":"G2424"}]},{"number":10,"text":"прошу тебя о сыне моем Онисиме, которого родил я в узах моих:","words":[{"o":"παρακαλῶ","t":"parakalō","r":"я ексхорт","s":"G3870"},{"o":"σε","t":"se","r":"ты","s":"G4771"},{"o":"περὶ","t":"peri","r":"для","s":"G4012"},{"o":"τοῦ","t":"tou","r":"","s":"G3588"},{"o":"ἐμοῦ","t":"emou","r":"мой","s":"G1473"},{"o":"τέκνου","t":"teknou","r":"дитя","s":"G5043"},{"o":"ὃν","t":"hon","r":"кого","s":"G3739"},{"o":"ἐγέννησα","t":"egennēsa","r":"я имеют рождённый","s":"G1080"},{"o":"ἐν","t":"en","r":"в","s":"G1722"},{"o":"τοῖς","t":"tois","r":"","s":"G3588"},{"o":"δεσμοῖς","t":"desmois","r":"цепи","s":"G1199"},{"o":"μου,","t":"mou","r":"мой","s":"G3165"},{"o":"Ὀνήσιμον,","t":"Onēsimon","r":"Онесимус,","s":"G3682"}]},{"number":11,"text":"он был некогда негоден для тебя, а теперь годен тебе и мне; я возвращаю его;","words":[{"o":"τόν","t":"ton","r":"","s":"G3588"},{"o":"ποτέ","t":"pote","r":"однажды","s":"G4218"},{"o":"σοι","t":"soi","r":"к ты","s":"G4771"},{"o":"ἄχρηστον","t":"achrēston","r":"уселесс","s":"G0890"},{"o":"νυνὶ","t":"nuni","r":"ныне","s":"G3570"},{"o":"δὲ","t":"de","r":"однако","s":"G1161"},{"o":"καὶ","t":"kai","r":"оба","s":"G2532"},{"o":"σοὶ","t":"soi","r":"к ты","s":"G4771"},{"o":"καὶ","t":"kai","r":"и","s":"G2532"},{"o":"ἐμοὶ","t":"emoi","r":"к меня себя","s":"G1473"},{"o":"εὔχρηστον,","t":"euchrēston","r":"усефул,","s":"G2173"}]},{"number":12,"text":"ты же прими его, как мое сердце.","words":[{"o":"ὃν","t":"hon","r":"кого","s":"G3739"},{"o":"ἀνέπεμψά","t":"anepempsa","r":"я имеют послал назад","s":"G0375"},{"o":"σοι","t":"soi","r":"к ты","s":"G4771"},{"o":"δὲ","t":"de","r":"ныне","s":"G1161"},{"o":"αὐτόν,","t":"auton","r":"в лицо —","s":"G0846"},{"o":"τοῦτ᾽","t":"tout᾽","r":"кто","s":"G3778"},{"o":"ἔστιν","t":"estin","r":"есть","s":"G1510"},{"o":"τὰ","t":"ta","r":"","s":"G3588"},{"o":"ἐμὰ","t":"ema","r":"мой","s":"G1473"},{"o":"σπλάγχνα","t":"splagchna","r":"очень сердце —","s":"G4698"},{"o":"προσλαβοῦ.","t":"proslabou","r":"делать себя принять.","s":"G4355"}]},{"number":13,"text":"Я хотел при себе удержать его, дабы он вместо тебя послужил мне в узах за благовествование;","words":[{"o":"ὃν","t":"hon","