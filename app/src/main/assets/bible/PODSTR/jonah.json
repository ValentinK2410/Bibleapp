{"translation":"PODSTR","book":{"id":"jonah","name":"Иона","chapters":[{"number":1,"verses":[{"number":1,"text":"И было слово Господне к Ионе, сыну Амафиину:","words":[{"o":"וַֽיְהִי֙","t":"vayHi","r":"и, оно пришёл","s":"H9001"},{"o":"דְּבַר\\־","t":"devar-","r":"слово","s":"H1697"},{"o":"יְהוָ֔ה","t":"Yahweh","r":"Яхве","s":"H3068"},{"o":"אֶל\\־","t":"'el-","r":"к","s":"H0413"},{"o":"יוֹנָ֥ה","t":"yoNah","r":"Иона","s":"H3124"},{"o":"בֶן\\־","t":"ven-","r":"сын","s":"H1121"},{"o":"אֲמִתַּ֖י","t":"'amiTai","r":"Амиттаи","s":"H0573"},{"o":"לֵאמֹֽר\\׃","t":"leMor","r":"к, говоря","s":"H9005"}]},{"number":2,"text":"встань, иди в Ниневию, город великий, и проповедуй в нем, ибо злодеяния его дошли до Меня.","words":[{"o":"ק֠וּם","t":"kum","r":"восстать","s":"H6965"},{"o":"לֵ֧ךְ","t":"lekh","r":"идти","s":"H1980"},{"o":"אֶל\\־","t":"'el-","r":"к","s":"H0413"},{"o":"נִֽינְוֵ֛ה","t":"ninVeh","r":"Ниневех","s":"H5210"},{"o":"הָעִ֥יר","t":"ha'Ir","r":"город","s":"H9009"},{"o":"הַגְּדוֹלָ֖ה","t":"hagedoLah","r":"великий","s":"H9009"},{"o":"וּקְרָ֣א","t":"ukeRa'","r":"и, звать вне","s":"H9002"},{"o":"עָלֶ֑יהָ","t":"'aLeiha","r":"на, оно","s":"H5921"},{"o":"כִּֽי\\־","t":"ki-","r":"для","s":"H3588"},{"o":"עָלְתָ֥ה","t":"'alTah","r":"оно имеет прийти вверх","s":"H5927"},{"o":"רָעָתָ֖ם","t":"ra'aTam","r":"нечестие, их","s":"H7451"},{"o":"לְפָנָֽי\\׃","t":"lefaNai","r":"к, перед, меня","s":"H9005"}]},{"number":3,"text":"И встал Иона, чтобы бежать в Фарсис от лица Господня, и пришел в Иоппию, и нашел корабль, отправлявшийся в Фарсис, отдал плату за провоз и вошел в него, чтобы плыть с ними в Фарсис от лица Господа.","words":[{"o":"וַיָּ֤קָם","t":"vaiYakom","r":"и, он встал","s":"H9001"},{"o":"יוֹנָה֙","t":"yoNah","r":"Иона","s":"H3124"},{"o":"לִבְרֹ֣חַ","t":"livRoach","r":"к, бежать","s":"H9005"},{"o":"תַּרְשִׁ֔ישָׁה","t":"tarShishah","r":"Таршиш, к","s":"H8659"},{"o":"מִלִּפְנֵ֖י","t":"milifNei","r":"от, к, перед","s":"H9006"},{"o":"יְהוָ֑ה","t":"Yahweh","r":"Яхве","s":"H3068"},{"o":"וַיֵּ֨רֶד","t":"vaiYered","r":"и, он пошёл вниз","s":"H9001"},{"o":"יָפ֜וֹ","t":"yaFo","r":"Джоппа","s":"H3305"},{"o":"וַיִּמְצָ֥א","t":"vaiyimTza'","r":"и, он нашёл","s":"H9001"},{"o":"אָנִיָּ֣ה\\׀","t":"'aniYah","r":"корабль","s":"H0591"},{"o":"בָּאָ֣ה","t":"ba'Ah","r":"который был о к идти","s":"H0935"},{"o":"תַרְשִׁ֗ישׁ","t":"tarShish","r":"Таршиш","s":"H8659"},{"o":"וַיִּתֵּ֨ן","t":"vaiyiTen","r":"и, он дал","s":"H9001"},{"o":"שְׂכָרָ֜הּ","t":"sekhaRah","r":"фаре, его","s":"H7939"},{"o":"וַיֵּ֤רֶד","t":"vaiYered","r":"и, он пошёл вниз","s":"H9001"},{"o":"בָּהּ֙","t":"bah","r":"в, оно","s":"H9003"},{"o":"לָב֤וֹא","t":"laVo'","r":"к, идти","s":"H9005"},{"o":"עִמָּהֶם֙","t":"'imaHem","r":"с, их","s":"H5973"},{"o":"תַּרְשִׁ֔ישָׁה","t":"tarShishah","r":"Таршиш, к","s":"H8659"},{"o":"מִלִּפְנֵ֖י","t":"milifNei","r":"от, к, перед","s":"H9006"},{"o":"יְהוָֽה\\׃","t":"Yahweh","r":"Яхве","s":"H3068"}]},{"number":4,"text":"Но Господь воздвиг на море крепкий ветер, и сделалась на море великая буря, и корабль готов был разбиться.","words":[{"o":"וַֽיהוָ֗ה","t":"vaYahweh","r":"и, Яхве","s":"H9002"},{"o":"הֵטִ֤יל","t":"heTil","r":"он бросил","s":"H2904"},{"o":"רֽוּחַ\\־","t":"Ruach-","r":"ветер","s":"H7307"},{"o":"גְּדוֹלָה֙","t":"gedoLah","r":"великий","s":"H1419"},{"o":"אֶל\\־","t":"'el-","r":"к","s":"H0413"},{"o":"הַיָּ֔ם","t":"haiYam","r":"море","s":"H9009"},{"o":"וַיְהִ֥י","t":"vayHi","r":"и, оно был","s":"H9001"},{"o":"סַֽעַר\\־","t":"sa'ar-","r":"буря","s":"H5591"},{"o":"גָּד֖וֹל","t":"gaDol","r":"великий","s":"H1419"},{"o":"בַּיָּ֑ם","t":"baiYam","r":"на, море","s":"H9003"},{"o":"וְהָ֣אֳנִיָּ֔ה","t":"veHo'oniYah","r":"и, корабль","s":"H9002"},{"o":"חִשְּׁבָ֖ה","t":"chisheVah","r":"оно мысль","s":"H2803"},{"o":"לְהִשָּׁבֵֽר\\׃","t":"lehishaVer","r":"к, быть сломанный","s":"H9005"}]},{"number":5,"text":"И устрашились корабельщики, и взывали каждый к своему богу, и стали бросать в море кладь с корабля, чтобы облегчить его от нее; Иона же спустился во внутренность корабля, лег и крепко заснул.","words":[{"o":"וַיִּֽירְא֣וּ","t":"vaiyire'U","r":"и, они были боящийся","s":"H9001"},{"o":"הַמַּלָּחִ֗ים","t":"hamalaChim","r":"саилорс","s":"H9009"},{"o":"וַֽיִּזְעֲקוּ֮","t":"vaiyiz'aKu","r":"и, они воззвал для помочь","s":"H9001"},{"o":"אִ֣ישׁ","t":"'ish","r":"каждый","s":"H0376"},{"o":"אֶל\\־","t":"'el-","r":"к","s":"H0413"},{"o":"אֱלֹהָיו֒","t":"'eloHav","r":"боги, его","s":"H0430"},{"o":"וַיָּטִ֨לוּ","t":"vaiyaTilu","r":"и, они бросил","s":"H9001"},{"o":"אֶת\\־","t":"'et-","r":"","s":"H0853"},{"o":"הַכֵּלִ֜ים","t":"hakeLim","r":"сосуды","s":"H9009"},{"o":"אֲשֶׁ֤ר","t":"'aSher","r":"который","s":"H0834"},{"o":"בָּֽאֳנִיָּה֙","t":"bo'oniYah","r":"были в, корабль","s":"H9003"},{"o":"אֶל\\־","t":"'el-","r":"в","s":"H0413"},{"o":"הַיָּ֔ם","t":"haiYam","r":"море","s":"H9009"},{"o":"לְהָקֵ֖ל","t":"lehaKel","r":"к, лигхтен","s":"H9005"},{"o":"מֵֽעֲלֵיהֶ֑ם","t":"me'aleiHem","r":"от, на, их","s":"H9006"},{"o":"וְיוֹנָ֗ה","t":"veyoNah","r":"и, Иона","s":"H9002"},{"o":"יָרַד֙","t":"yaRad","r":"он имел ушёл вниз","s":"H3381"},{"o":"אֶל\\־","t":"'el-","r":"в","s":"H0413"},{"o":"יַרְכְּתֵ֣י","t":"yarkeTei","r":"иннермост части","s":"H3411"},{"o":"הַסְּפִינָ֔ה","t":"hasefiNah","r":"корабль","s":"H9009"},{"o":"וַיִּשְׁכַּ֖ב","t":"vaiyishKav","r":"и, он имел лаин вниз","s":"H9001"},{"o":"וַיֵּרָדַֽם\\׃","t":"vaiyeraDam","r":"и, он имел падший пост аслип","s":"H9001"}]},{"number":6,"text":"И пришел к нему начальник корабля и сказал ему: что ты спишь? встань, воззови к Богу твоему; может быть, Бог вспомнит о нас и мы не погибнем.","words":[{"o":"וַיִּקְרַ֤ב","t":"vaiyikRav","r":"и, он вытянул вблизи","s":"H9001"},{"o":"אֵלָיו֙","t":"'eLav","r":"к, его","s":"H0413"},{"o":"רַ֣ב","t":"rav","r":"начальник","s":"H7227"},{"o":"הַחֹבֵ֔ל","t":"hachoVel","r":"саилорс","s":"H9009"},{"o":"וַיֹּ֥אמֶר","t":"vaiYomer","r":"и, он сказал","s":"H9001"},{"o":"ל֖וֹ","t":"lo","r":"к, его","s":"H9005"},{"o":"מַה\\־","t":"mah-","r":"что?","s":"H4100"},{"o":"לְּךָ֣","t":"leKha","r":"есть к, ты","s":"H9005"},{"o":"נִרְדָּ֑ם","t":"nirDam","r":"спящий","s":"H7290"},{"o":"ק֚וּם","t":"kum","r":"восстать","s":"H6965"},{"o":"קְרָ֣א","t":"keRa'","r":"звать","s":"H7121"},{"o":"אֶל\\־","t":"'el-","r":"к","s":"H0413"},{"o":"אֱלֹהֶ֔יךָ","t":"'eloHeikha","r":"бог, твой","s":"H0430"},{"o":"אוּלַ֞י","t":"'uLai","r":"может быть","s":"H0194"},{"o":"יִתְעַשֵּׁ֧ת","t":"yit'aShet","r":"он будет давать мысль","s":"H6245"},{"o":"הָאֱלֹהִ֛ים","t":"ha'EloHim","r":"бог","s":"H9009"},{"o":"לָ֖נוּ","t":"Lanu","r":"к, нас","s":"H9005"},{"o":"וְלֹ֥א","t":"veLo'","r":"и, не","s":"H9002"},{"o":"נֹאבֵֽד\\׃","t":"noVed","r":"мы будет погибнуть","s":"H0006"}]},{"number":7,"text":"И сказали друг другу: пойдем, бросим жребии, чтобы узнать, за кого постигает нас эта беда. И бросили жребии, и пал жребий на Иону.","words":[{"o":"וַיֹּאמְר֞וּ","t":"vaiyomeRu","r":"и, они сказал","s":"H9001"},{"o":"אִ֣ישׁ","t":"'ish","r":"каждый","s":"H0376"},{"o":"אֶל\\־","t":"'el-","r":"к","s":"H0413"},{"o":"רֵעֵ֗הוּ","t":"re'Ehu","r":"ближний, его","s":"H7453"},{"o":"לְכוּ֙","t":"leKhu","r":"прийти","s":"H1980"},{"o":"וְנַפִּ֣ילָה","t":"venaPilah","r":"так, позволить нас бросить","s":"H9002"},{"o":"גֽוֹרָל֔וֹת","t":"goraLot","r":"жребии","s":"H1486"},{"o":"וְנֵ֣דְעָ֔ה","t":"veNede'Ah","r":"так, мы да знать","s":"H9002"},{"o":"בְּשֶׁלְּמִ֛י","t":"besheleMi","r":"через, который, кого?","s":"H9003"},{"o":"הָרָעָ֥ה","t":"hara'Ah","r":"зло","s":"H9009"},{"o":"הַזֹּ֖את","t":"haZot","r":"это","s":"H9009"},{"o":"לָ֑נוּ","t":"Lanu","r":"принадлежит к, нас","s":"H9005"},{"o":"וַיַּפִּ֙לוּ֙","t":"vaiyaPilu","r":"и, они бросить","s":"H9001"},{"o":"גּֽוֹרָל֔וֹת","t":"goraLot","r":"жребии","s":"H1486"},{"o":"וַיִּפֹּ֥ל","t":"vaiyiPol","r":"и, оно упал","s":"H9001"},{"o":"הַגּוֹרָ֖ל","t":"hagoRal","r":"жребий","s":"H9009"},{"o":"עַל\\־","t":"'al-","r":"на","s":"H5921"},{"o":"יוֹנָֽה\\׃","t":"yoNah","r":"Иона","s":"H3124"}]},{"number":8,"text":"Тогда сказали ему: скажи нам, за кого постигла нас эта беда?