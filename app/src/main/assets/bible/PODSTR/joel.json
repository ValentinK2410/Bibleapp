},{"number":20,"text":"Даже и животные на поле взывают к Тебе, потому что иссохли потоки вод, и огонь истребил пастбища пустыни.","words":[{"o":"גַּם\\־","t":"gam-","r":"также","s":"H1571"},{"o":"בַּהֲמ֥וֹת","t":"bahaMot","r":"животные","s":"H0929"},{"o":"שָׂדֶ֖ה","t":"saDeh","r":"поле","s":"H7704"},{"o":"תַּעֲר֣וֹג","t":"ta'aRog","r":"оно панц","s":"H6165"},{"o":"אֵלֶ֑יךָ","t":"'eLeikha","r":"к, ты","s":"H0413"},{"o":"כִּ֤י","t":"ki","r":"для","s":"H3588"},{"o":"יָֽבְשׁוּ֙","t":"yaveShu","r":"они имеют высохший вверх","s":"H3001"},{"o":"אֲפִ֣יקֵי","t":"'aFikei","r":"чаннелс","s":"H0650"},{"o":"מָ֔יִם","t":"Mayim","r":"вода","s":"H4325"},{"o":"וְאֵ֕שׁ","t":"ve'Esh","r":"и, огонь","s":"H9002"},{"o":"אָכְלָ֖ה","t":"'akheLah","r":"оно имеет поглощён","s":"H0398"},{"o":"נְא֥וֹת","t":"ne'ot","r":"пастбища","s":"H4999"},{"o":"הַמִּדְבָּֽר\\׃\\ \\פ","t":"hamidBar","r":"пустыня","s":"H9009"}]}]},{"number":2,"verses":[{"number":1,"text":"Трубите трубою на Сионе и бейте тревогу на святой горе Моей; да трепещут все жители земли, ибо наступает день Господень, ибо он близок -","words":[{"o":"תִּקְע֨וּ","t":"tik'U","r":"давать дуновение на","s":"H8628"},{"o":"שׁוֹפָ֜ר","t":"shoFar","r":"рам'с рог","s":"H7782"},{"o":"בְּצִיּ֗וֹן","t":"betziYon","r":"в, Сион","s":"H9003"},{"o":"וְהָרִ֙יעוּ֙","t":"vehaRi'u","r":"и, звук битва сигнал","s":"H9002"},{"o":"בְּהַ֣ר","t":"beHar","r":"на, гора","s":"H9003"},{"o":"קָדְשִׁ֔י","t":"kodshi","r":"святость, мой","s":"H6944"},{"o":"יִרְגְּז֕וּ","t":"yirgeZu","r":"позволить их трепетать","s":"H7264"},{"o":"כֹּ֖ל","t":"kol","r":"все","s":"H3605"},{"o":"יֹשְׁבֵ֣י","t":"yosheVei","r":"жители","s":"H3427"},{"o":"הָאָ֑רֶץ","t":"ha'Aretz","r":"земля","s":"H9009"},{"o":"כִּֽי\\־","t":"ki-","r":"для","s":"H3588"},{"o":"בָ֥א","t":"va'","r":"есть о к прийти","s":"H0935"},{"o":"יוֹם\\־","t":"yom-","r":"день","s":"H3117"},{"o":"יְהוָ֖ה","t":"Yahweh","r":"Яхве","s":"H3068"},{"o":"כִּ֥י","t":"ki","r":"для","s":"H3588"},{"o":"קָרֽוֹב\\׃","t":"kaRov","r":"оно есть вблизи","s":"H7138"}]},{"number":2,"text":"день тьмы и мрака, день облачный и туманный: как утренняя заря распространяется по горам народ многочисленный и сильный, какого не бывало от века и после того не будет в роды родов.","words":[{"o":"י֧וֹם","t":"Yom","r":"день","s":"H3117"},{"o":"חֹ֣שֶׁךְ","t":"Choshekh","r":"тьма","s":"H2822"},{"o":"וַאֲפֵלָ֗ה","t":"va'afeLah","r":"и, глум","s":"H9002"},{"o":"י֤וֹם","t":"Yom","r":"день","s":"H3117"},{"o":"עָנָן֙","t":"'aNan","r":"облако","s":"H6051"},{"o":"וַעֲרָפֶ֔ל","t":"va'araFel","r":"и, фикк тьма","s":"H9002"},{"o":"כְּשַׁ֖חַר","t":"keShachar","r":"как, заря","s":"H9004"},{"o":"פָּרֻ֣שׂ","t":"paRus","r":"распростёр вне","s":"H6566"},{"o":"עַל\\־","t":"'al-","r":"над","s":"H5921"},{"o":"הֶֽהָרִ֑ים","t":"hehaRim","r":"горы","s":"H9009"},{"o":"עַ֚ם","t":"'am","r":"народ","s":"H5971"},{"o":"רַ֣ב","t":"rav","r":"многочисленный","s":"H7227"},{"o":"וְעָצ֔וּם","t":"ve'aTzum","r":"и, могучий","s":"H9002"},{"o":"כָּמֹ֗הוּ","t":"kaMohu","r":"как, оно","s":"H3644"},{"o":"לֹ֤א","t":"lo'","r":"не","s":"H3808"},{"o":"נִֽהְיָה֙","t":"nihYah","r":"оно имеет оккурред","s":"H1961"},{"o":"מִן\\־","t":"min-","r":"с тех пор","s":"H4480"},{"o":"הָ֣עוֹלָ֔ם","t":"ha'oLam","r":"древность","s":"H9009"},{"o":"וְאַֽחֲרָיו֙","t":"ve'achaRav","r":"и, после, оно","s":"H9002"},{"o":"לֹ֣א","t":"lo'","r":"не","s":"H3808"},{"o":"יוֹסֵ֔ף","t":"yoSef","r":"оно будет повторить","s":"H3254"},{"o":"עַד\\־","t":"'ad-","r":"до","s":"H5704"},{"o":"שְׁנֵ֖י","t":"sheNei","r":"годы","s":"H8141"},{"o":"דּ֥וֹר","t":"Dor","r":"поколение","s":"H1755"},{"o":"וָדֽוֹר\\׃","t":"vaDor","r":"и, поколение","s":"H9002"}]},{"number":3,"text":"Перед ним пожирает огонь, а за ним палит пламя; перед ним земля как сад Едемский, а позади него будет опустошенная степь, и никому не будет спасения от него.","words":[{"o":"לְפָנָיו֙","t":"lefaNav","r":"к, перед, оно","s":"H9005"},{"o":"אָ֣כְלָה","t":"'Akhelah","r":"оно имеет поглощён","s":"H0398"},{"o":"אֵ֔שׁ","t":"'Esh","r":"огонь","s":"H0784"},{"o":"וְאַחֲרָ֖יו","t":"ve'achaRav","r":"и, после, оно","s":"H9002"},{"o":"תְּלַהֵ֣ט","t":"telaHet","r":"оно ставит аблазе","s":"H3857"},{"o":"לֶֽהָבָ֑ה","t":"lehaVah","r":"пламя","s":"H3852"},{"o":"כְּגַן\\־","t":"kegan-","r":"есть как, сад","s":"H9004"},{"o":"עֵ֨דֶן","t":"'Eden","r":"Еден","s":"H5731"},{"o":"הָאָ֜רֶץ","t":"ha'Aretz","r":"земля","s":"H9009"},{"o":"לְפָנָ֗יו","t":"lefaNav","r":"к, перед, оно","s":"H9005"},{"o":"וְאַֽחֲרָיו֙","t":"ve'achaRav","r":"и, после, оно","s":"H9002"},{"o":"מִדְבַּ֣ר","t":"midBar","r":"пустыня","s":"H4057"},{"o":"שְׁמָמָ֔ה","t":"shemaMah","r":"запустение","s":"H8077"},{"o":"וְגַם\\־","t":"vegam-","r":"и, также","s":"H9002"},{"o":"פְּלֵיטָ֖ה","t":"peleiTah","r":"спастись","s":"H6413"},{"o":"לֹא\\־","t":"lo'-","r":"не","s":"H3808"},{"o":"הָ֥יְתָה","t":"Hayetah","r":"оно принадлежит","s":"H1961"},{"o":"לּֽוֹ\\׃","t":"lo","r":"к, оно","s":"H9005"}]},{"number":4,"text":"Вид его как вид коней, и скачут они как всадники;","words":[{"o":"כְּמַרְאֵ֥ה","t":"kemar'Eh","r":"есть как, вид","s":"H9004"},{"o":"סוּסִ֖ים","t":"suSim","r":"кони","s":"H5483"},{"o":"מַרְאֵ֑הוּ","t":"mar'Ehu","r":"вид, его","s":"H4758"},{"o":"וּכְפָרָשִׁ֖ים","t":"ukhefaraShim","r":"и, как, всадники","s":"H9002"},{"o":"כֵּ֥ן","t":"ken","r":"так","s":"H3651"},{"o":"יְרוּצֽוּן\\׃","t":"yeruTzun","r":"они бежать, !","s":"H7323"}]},{"number":5,"text":"скачут по вершинам гор как бы со стуком колесниц, как бы с треском огненного пламени, пожирающего солому, как сильный народ, выстроенный к битве.","words":[{"o":"כְּק֣וֹל","t":"keKol","r":"как, звук","s":"H9004"},{"o":"מַרְכָּב֗וֹת","t":"markaVot","r":"колесницы","s":"H4818"},{"o":"עַל\\־","t":"'al-","r":"над","s":"H5921"},{"o":"רָאשֵׁ֤י","t":"raShei","r":"вершина","s":"H7218"},{"o":"הֶֽהָרִים֙","t":"hehaRim","r":"горы","s":"H9009"},{"o":"יְרַקֵּד֔וּן","t":"yerakeDun","r":"они леап, !","s":"H7540"},{"o":"כְּקוֹל֙","t":"kekOl","r":"как, звук","s":"H9004"},{"o":"לַ֣הַב","t":"Lahav","r":"пламя","s":"H3851"},{"o":"אֵ֔שׁ","t":"'Esh","r":"огонь","s":"H0784"},{"o":"אֹכְלָ֖ה","t":"'okheLah","r":"консуминг","s":"H0398"},{"o":"קָ֑שׁ","t":"Kash","r":"стуббле","s":"H7179"},{"o":"כְּעַ֣ם","t":"ke'Am","r":"как, народ","s":"H9004"},{"o":"עָצ֔וּם","t":"'aTzum","r":"могучий","s":"H6099"},{"o":"עֱר֖וּךְ","t":"'eRukh","r":"деплойед","s":"H6186"},{"o":"מִלְחָמָֽה\\׃","t":"milchaMah","r":"битва","s":"H4421"}]},{"number":6,"text":"При виде его затрепещут народы, у всех лица побледнеют.","words":[{"o":"מִפָּנָ֖יו","t":"mipaNav","r":"от, перед, оно","s":"H9006"},{"o":"יָחִ֣ילוּ","t":"yaChilu","r":"они есть в ангуиш","s":"H2342"},{"o":"עַמִּ֑ים","t":"'aMim","r":"народы","s":"H5971"},{"o":"כָּל\\־","t":"kol-","r":"все","s":"H3605"},{"o":"פָּנִ֖ים","t":"paNim","r":"лицо","s":"H6440"},{"o":"קִבְּצ֥וּ","t":"kibeTzu","r":"они собирать","s":"H6908"},{"o":"פָארֽוּר\\׃","t":"faRur","r":"глов","s":"H6289"}]},{"number":7,"text":"Как борцы бегут они и как храбрые воины влезают на стену, и каждый идет своею дорогою, и не сбивается с путей своих.","words":[{"o":"כְּגִבּוֹרִ֣ים","t":"kegiboRim","r":"как, воины","s":"H9004"},{"o":"יְרֻצ֔וּן","t":"yeruTzun","r":"они бежать, !","s":"H7323"},{"o":"כְּאַנְשֵׁ֥י","t":"ke'anShei","r":"как, люди","s":"H9004"},{"o":"מִלְחָמָ֖ה","t":"milchaMah","r":"война","s":"H4421"},{"o":"יַעֲל֣וּ","t":"ya'aLu","r":"они идти вверх","s":"H5927"},{"o":"חוֹמָ֑ה","t":"choMah","r":"стена","s":"H2346"},{"o":"וְאִ֤ישׁ","t":"ve'Ish","r":"и, каждый","s":"H9002"},{"o":"בִּדְרָכָיו֙","t":"bidraKhav","r":"на, пути, его","s":"H9003"},{"o":"יֵֽלֵכ֔וּן","t":"yeleKhun","r":"они идти, !","s":"H1980"},{"o":"וְלֹ֥א","t":"veLo'","r":"и, не","s":"H9002"},{"o":"יְעַבְּט֖וּן","t":"ye'abeTun","r":"они ексчанге, !","s":"H5670"},{"o":"אֹרְחוֹתָֽם\\׃","t":"'orechoTam","r":"пути, их","s":"H0734"}]},{"number":8,"text":"Не давят друг друга, каждый идет своею стезею, и падают на копья, но остаются невредимы.","words":[{"o":"וְאִ֤ישׁ","t":"ve'Ish","r":"и, каждый","s":"H9002"},{"o":"אָחִיו֙","t":"'aChiv","r":"брат, его","s":"H0251"},{"o":"לֹ֣א","t":"lo'","r":"не","s":"H3808"},{"o":"יִדְחָק֔וּן","t":"yidchaKun","r":"они толпа, !","s":"H1766"},{"o":"גֶּ֥בֶר","t":"Gever","r":"человек","s":"H1397"},{"o":"בִּמְסִלָּת֖וֹ","t":"bimsilaTo","r":"на, тракк, его","s":"H9003"},{"o":"יֵֽלֵכ֑וּן","t":"yeleKhun","r":"они идти, !","s":"H1980"},{"o":"וּבְעַ֥ד","t":"uve'Ad","r":"и, через","s":"H9002"},{"o":"הַשֶּׁ֛לַח","t":"haShelach","r":"оружие","s":"H9009"},{"o":"יִפֹּ֖לוּ","t":"yiPolu","r":"они упасть","s":"H5307"},{"o":"לֹ֥א","t":"lo'","r":"не","s":"H3808"},{"o":"יִבְצָֽעוּ\\׃","t":"yivTza'u","r":"они стоп","s":"H1214"}]},{"number":9,"text":"Бегают по городу, поднимаются на стены, влезают на дома, входят в окна, как вор.","words":[{"o":"בָּעִ֣יר","t":"ba'Ir","r":"на, город","s":"H9003"},{"o":"יָשֹׁ֗קּוּ","t":"yaShoku","r":"они руш","s":"H8264"},{"o":"בַּֽחוֹמָה֙","t":"bachoMah","r":"на, стена","s":"H9003"},{"o":"יְרֻצ֔וּן","t":"yeruTzun","r":"они бежать, !","s":"H7323"},{"o":"בַּבָּתִּ֖ים","t":"babaTim","r":"в, дома","s":"H9003"},{"o":"יַעֲל֑וּ","t":"ya'aLu","r":"они идти вверх","s":"H5927"},{"o":"בְּעַ֧ד","t":"be'Ad","r":"через","s":"H1157"},{"o":"הַחַלּוֹנִ֛ים","t":"hachaloNim","r":"окна","s":"H9009"},{"o":"יָבֹ֖אוּ","t":"yaVo'u","r":"они идти","s":"H0935"},{"o":"כַּגַּנָּֽב\\׃","t":"kagaNav","r":"как, фиеф","s":"H9004"}]},{"number":10,"text":"Перед ними потрясется земля, поколеблется небо; солнце и луна помрачатся, и звезды потеряют свой свет.","words":[{"o":"לְפָנָיו֙","t":"lefaNav","r":"к, перед, оно","s":"H9005"},{"o":"רָ֣גְזָה","t":"Ragezah","r":"оно трепетать","s":"H7264"},{"o":"אֶ֔רֶץ","t":"'Eretz","r":"земля","s":"H0776"},{"o":"רָעֲשׁ֖וּ","t":"ra'aShu","r":"они шаке","s":"H7493"},{"o":"שָׁמָ֑יִם","t":"shaMayim","r":"небеса","s":"H8064"},{"o":"שֶׁ֤מֶשׁ","t":"Shemesh","r":"солнце","s":"H8121"},{"o":"וְיָרֵ֙חַ֙","t":"veyaReach","r":"и, луна","s":"H9002"},{"o":"קָדָ֔רוּ","t":"kaDaru","r":"они стать тёмный","s":"H6937"},{"o":"וְכוֹכָבִ֖ים","t":"vekhokhaVim","r":"и, звёзды","s":"H9002"},{"o":"אָסְפ֥וּ","t":"'aseFu","r":"они вифдрав","s":"H0622"},{"o":"נָגְהָֽם\\׃","t":"nageHam","r":"бригхтнесс, их","s":"H5051"}]},{"number":11,"text":"И Господь даст глас Свой пред воинством Своим, ибо весьма многочисленно полчище Его и могуществен исполнитель слова Его; ибо велик день Господень и весьма страшен, и кто выдержит его?","words":[{"o":"וַֽיהוָ֗ה","t":"vaYahweh","r":"и, Яхве","s":"H9002"},{"o":"נָתַ֤ן","t":"naTan","r":"он давать вперёд","s":"H5414"},{"o":"קוֹלוֹ֙","t":"koLo","r":"голос, его","s":"H6963"},{"o":"לִפְנֵ֣י","t":"lifNei","r":"к, перед","s":"H9005"},{"o":"חֵיל֔וֹ","t":"cheiLo","r":"войско, его","s":"H2428"},{"o":"כִּ֣י","t":"ki","r":"для","s":"H3588"},{"o":"רַ֤ב","t":"rav","r":"есть великий","s":"H7227"},{"o":"מְאֹד֙","t":"me'Od","r":"очень","s":"H3966"},{"o":"מַחֲנֵ֔הוּ","t":"machaNehu","r":"стан, его","s":"H4264"},{"o":"כִּ֥י","t":"ki","r":"для","s":"H3588"},{"o":"עָצ֖וּם","t":"'aTzum","r":"есть могучий","s":"H6099"},{"o":"עֹשֵׂ֣ה","t":"'oSeh","r":"один кто делает","s":"H6213"},{"o":"דְבָר֑וֹ","t":"devaRo","r":"слово, его","s":"H1697"},{"o":"כִּֽי\\־","t":"ki-","r":"для","s":"H3588"},{"o":"גָד֧וֹל","t":"gaDol","r":"есть великий","s":"H1419"},{"o":"יוֹם\\־","t":"yom-","r":"день","s":"H3117"},{"o":"יְהוָ֛ה","t":"Yahweh","r":"Яхве","s":"H3068"},{"o":"וְנוֹרָ֥א","t":"venoRa'","r":"и, авесоме","s":"H9002"},{"o":"מְאֹ֖ד","t":"me'Od","r":"чрезвычайно","s":"H3966"},{"o":"וּמִ֥י","t":"uMi","r":"и, кто?","s":"H9002"},{"o":"יְכִילֶֽנּוּ\\׃","t":"yekhiLenu","r":"будет он ендуре, оно","s":"H3557"}]},{"number":12,"text":"Но и ныне еще говорит Господь: обратитесь ко Мне всем сердцем своим в посте, плаче и рыдании.","words":[{"o":"וְגַם\\־","t":"vegam-","r":"и, также","s":"H9002"},{"o":"עַתָּה֙","t":"'aTah","r":"ныне","s":"H6258"},{"o":"נְאֻם\\־","t":"ne'um-","r":"изречение","s":"H5002"},{"o":"יְהוָ֔ה","t":"Yahweh","r":"Яхве","s":"H3068"},{"o":"שֻׁ֥בוּ","t":"Shuvu","r":"возвратиться","s":"H7725"},{"o":"עָדַ֖י","t":"'aDai","r":"к, меня","s":"H5704"},{"o":"בּ