{"translation":"PODSTR","book":{"id":"joel","name":"Иоиль","chapters":[{"number":1,"verses":[{"number":1,"text":"Слово Господне, которое было к Иоилю, сыну Вафуила.","words":[{"o":"דְּבַר\\־","t":"devar-","r":"слово","s":"H1697"},{"o":"יְהוָה֙","t":"Yahweh","r":"Яхве","s":"H3068"},{"o":"אֲשֶׁ֣ר","t":"'aSher","r":"который","s":"H0834"},{"o":"הָיָ֔ה","t":"haYah","r":"оно пришёл","s":"H1961"},{"o":"אֶל\\־","t":"'el-","r":"к","s":"H0413"},{"o":"יוֹאֵ֖ל","t":"yo'El","r":"Иоиль","s":"H3100"},{"o":"בֶּן\\־","t":"ben-","r":"сын","s":"H1121"},{"o":"פְּתוּאֵֽל\\׃","t":"petu'El","r":"Пефуел","s":"H6602"}]},{"number":2,"text":"Слушайте это, старцы, и внимайте, все жители земли сей: бывало ли такое во дни ваши, или во дни отцов ваших?","words":[{"o":"שִׁמְעוּ\\־","t":"shim'u-","r":"слышать","s":"H8085"},{"o":"זֹאת֙","t":"zoT","r":"это","s":"H2063"},{"o":"הַזְּקֵנִ֔ים","t":"hazekeNim","r":"О, старейшины","s":"H9009"},{"o":"וְהַֽאֲזִ֔ינוּ","t":"veha'aZinu","r":"и, давать ухо","s":"H9002"},{"o":"כֹּ֖ל","t":"kol","r":"О все","s":"H3605"},{"o":"יוֹשְׁבֵ֣י","t":"yosheVei","r":"жители","s":"H3427"},{"o":"הָאָ֑רֶץ","t":"ha'Aretz","r":"земля","s":"H9009"},{"o":"הֶהָ֤יְתָה","t":"heHayetah","r":"¿, имеет оно случилось","s":"H9008"},{"o":"זֹּאת֙","t":"zoT","r":"это","s":"H2063"},{"o":"בִּֽימֵיכֶ֔ם","t":"bimeiKhem","r":"в, дни, твой","s":"H9003"},{"o":"וְאִ֖ם","t":"ve'Im","r":"и, или?","s":"H9002"},{"o":"בִּימֵ֥י","t":"biMei","r":"в, дни","s":"H9003"},{"o":"אֲבֹֽתֵיכֶֽם\\׃","t":"'aVoteiKhem","r":"предки, твой","s":"H0001"}]},{"number":3,"text":"Передайте об этом детям вашим; а дети ваши пусть скажут своим детям, а их дети следующему роду:","words":[{"o":"עָלֶ֖יהָ","t":"'aLeiha","r":"на, оно","s":"H5921"},{"o":"לִבְנֵיכֶ֣ם","t":"livneiKhem","r":"к, дети, твой","s":"H9005"},{"o":"סַפֵּ֑רוּ","t":"saPeru","r":"рекунт","s":"H5608"},{"o":"וּבְנֵיכֶם֙","t":"uveneiKhem","r":"и, дети, твой","s":"H9002"},{"o":"לִבְנֵיהֶ֔ם","t":"livneiHem","r":"к, дети, их","s":"H9005"},{"o":"וּבְנֵיהֶ֖ם","t":"uveneiHem","r":"и, дети, их","s":"H9002"},{"o":"לְד֥וֹר","t":"leDor","r":"к, поколение","s":"H9005"},{"o":"אַחֵֽר\\׃","t":"'aCher","r":"другой","s":"H0312"}]},{"number":4,"text":"оставшееся от гусеницы ела саранча, оставшееся от саранчи ели черви, а оставшееся от червей доели жуки.","words":[{"o":"יֶ֤תֶר","t":"Yeter","r":"ремаиндер","s":"H3499"},{"o":"הַגָּזָם֙","t":"hagaZam","r":"саранча","s":"H9009"},{"o":"אָכַ֣ל","t":"'aKhal","r":"оно имеет съеденный","s":"H0398"},{"o":"הָֽאַרְבֶּ֔ה","t":"ha'arBeh","r":"саранча","s":"H9009"},{"o":"וְיֶ֥תֶר","t":"veYeter","r":"и, ремаиндер","s":"H9002"},{"o":"הָאַרְבֶּ֖ה","t":"ha'arBeh","r":"саранча","s":"H9009"},{"o":"אָכַ֣ל","t":"'aKhal","r":"оно имеет съеденный","s":"H0398"},{"o":"הַיָּ֑לֶק","t":"haiYalek","r":"саранча","s":"H9009"},{"o":"וְיֶ֣תֶר","t":"veYeter","r":"и, ремаиндер","s":"H9002"},{"o":"הַיֶּ֔לֶק","t":"haiYelek","r":"саранча","s":"H9009"},{"o":"אָכַ֖ל","t":"'aKhal","r":"оно имеет съеденный","s":"H0398"},{"o":"הֶחָסִֽיל\\׃","t":"hechaSil","r":"саранча","s":"H9009"}]},{"number":5,"text":"Пробудитесь, пьяницы, и плачьте и рыдайте, все пьющие вино, о виноградном соке, ибо он отнят от уст ваших!","words":[{"o":"הָקִ֤יצוּ","t":"haKitzu","r":"аваке","s":"H6974"},{"o":"שִׁכּוֹרִים֙","t":"shikoRim","r":"О дрункардс","s":"H7910"},{"o":"וּבְכ֔וּ","t":"uveKhu","r":"и, плакать","s":"H9002"},{"o":"וְהֵילִ֖לוּ","t":"veheiLilu","r":"и, ваил","s":"H9002"},{"o":"כָּל\\־","t":"kol-","r":"О все","s":"H3605"},{"o":"שֹׁ֣תֵי","t":"Shotei","r":"дринкерс","s":"H8354"},{"o":"יָ֑יִן","t":"Yayin","r":"вино","s":"H3196"},{"o":"עַל\\־","t":"'al-","r":"на","s":"H5921"},{"o":"עָסִ֕יס","t":"'aSis","r":"сладкий вино","s":"H6071"},{"o":"כִּ֥י","t":"ki","r":"для","s":"H3588"},{"o":"נִכְרַ֖ת","t":"nikhRat","r":"оно имеет был отрезать прочь","s":"H3772"},{"o":"מִפִּיכֶֽם\\׃","t":"mipiKhem","r":"от, уста, твой","s":"H9006"}]},{"number":6,"text":"Ибо пришел на землю Мою народ сильный и бесчисленный; зубы у него - зубы львиные, и челюсти у него - как у львицы.","words":[{"o":"כִּֽי\\־","t":"ki-","r":"для","s":"H3588"},{"o":"גוֹי֙","t":"goy","r":"народ","s":"H1471"},{"o":"עָלָ֣ה","t":"'aLah","r":"оно имеет прийти вверх","s":"H5927"},{"o":"עַל\\־","t":"'al-","r":"на","s":"H5921"},{"o":"אַרְצִ֔י","t":"'arTzi","r":"земля, мой","s":"H0776"},{"o":"עָצ֖וּם","t":"'aTzum","r":"могучий","s":"H6099"},{"o":"וְאֵ֣ין","t":"ve'Ein","r":"и, там не","s":"H9002"},{"o":"מִסְפָּ֑ר","t":"misPar","r":"есть число","s":"H4557"},{"o":"שִׁנָּיו֙","t":"shiNav","r":"зубы, его","s":"H8127"},{"o":"שִׁנֵּ֣י","t":"shiNei","r":"есть зубы","s":"H8127"},{"o":"אַרְיֵ֔ה","t":"'arYeh","r":"лев","s":"H0738"},{"o":"וּֽמְתַלְּע֥וֹת","t":"umetale'ot","r":"и, фангс","s":"H9002"},{"o":"לָבִ֖יא","t":"laVi'","r":"лионесс","s":"H3833"},{"o":"לֽוֹ\\׃","t":"lo","r":"принадлежать к, оно","s":"H9005"}]},{"number":7,"text":"Опустошил он виноградную лозу Мою, и смоковницу Мою обломал, ободрал ее догола, и бросил; сделались белыми ветви ее.","words":[{"o":"שָׂ֤ם","t":"sam","r":"оно имеет сделал","s":"H7760"},{"o":"גַּפְנִי֙","t":"gafNi","r":"виноградная лоза, мой","s":"H1612"},{"o":"לְשַׁמָּ֔ה","t":"leshaMah","r":"в, пустошь","s":"H9005"},{"o":"וּתְאֵנָתִ֖י","t":"ute'enaTi","r":"и, смоква деревья, мой","s":"H9002"},{"o":"לִקְצָפָ֑ה","t":"liktzaFah","r":"в, стумп","s":"H9005"},{"o":"חָשֹׂ֤ף","t":"chaSof","r":"комплетелй стрип баре","s":"H2834"},{"o":"חֲשָׂפָהּ֙","t":"chasaFah","r":"оно имеет стриппед баре, оно","s":"H2834"},{"o":"וְהִשְׁלִ֔יךְ","t":"vehishLikh","r":"и, оно имеет брошенный оно прочь","s":"H9002"},{"o":"הִלְבִּ֖ינוּ","t":"hilBinu","r":"они имеют стать белый","s":"H3835"},{"o":"שָׂרִיגֶֽיהָ\\׃","t":"sariGeiha","r":"ветви, его","s":"H8299"}]},{"number":8,"text":"Рыдай, как молодая жена, препоясавшись вретищем, о муже юности своей!","words":[{"o":"אֱלִ֕י","t":"'eLi","r":"ваил","s":"H0421"},{"o":"כִּבְתוּלָ֥ה","t":"kivtuLah","r":"как, дева","s":"H9004"},{"o":"חֲגֻֽרַת\\־","t":"chagurat-","r":"гирдед","s":"H2296"},{"o":"שַׂ֖ק","t":"sak","r":"вретище","s":"H8242"},{"o":"עַל\\־","t":"'al-","r":"на","s":"H5921"},{"o":"בַּ֥עַל","t":"Ba'al","r":"муж","s":"H1167"},{"o":"נְעוּרֶֽיהָ\\׃","t":"ne'uReiha","r":"йуф<с>, её","s":"H5271"}]},{"number":9,"text":"Прекратилось хлебное приношение и возлияние в доме Господнем; плачут священники, служители Господни.","words":[{"o":"הָכְרַ֥ת","t":"hakheRat","r":"оно имеет был отрезать прочь","s":"H3772"},{"o":"מִנְחָ֛ה","t":"minChah","r":"зерно приношение","s":"H4503"},{"o":"וָנֶ֖סֶךְ","t":"vaNesekh","r":"и, пить приношение","s":"H9002"},{"o":"מִבֵּ֣ית","t":"miBeit","r":"от, дом","s":"H9006"},{"o":"יְהוָ֑ה","t":"Yahweh","r":"Яхве","s":"H3068"},{"o":"אָֽבְלוּ֙","t":"'aveLu","r":"они есть в оплакивая","s":"H0056"},{"o":"הַכֹּ֣הֲנִ֔ים","t":"haKohaNim","r":"священники","s":"H9009"},{"o":"מְשָׁרְתֵ֖י","t":"meshareTei","r":"рабы","s":"H8334"},{"o":"יְהוָֽה\\׃","t":"Yahweh","r":"Яхве","s":"H3068"}]},{"number":10,"text":"Опустошено поле, сетует земля; ибо истреблен хлеб, высох виноградный сок, завяла маслина.","words":[{"o":"שֻׁדַּ֣ד","t":"shuDad","r":"оно есть девастатед","s":"H7703"},{"o":"שָׂדֶ֔ה","t":"saDeh","r":"поля","s":"H7704"},{"o":"אָבְלָ֖ה","t":"'aveLah","r":"оно есть высохший вверх","s":"H0056"},{"o":"אֲדָמָ֑ה","t":"'adaMah","r":"земля","s":"H0127"},{"o":"כִּ֚י","t":"ki","r":"для","s":"H3588"},{"o":"שֻׁדַּ֣ד","t":"shuDad","r":"оно есть девастатед","s":"H7703"},{"o":"דָּגָ֔ן","t":"daGan","r":"зерно","s":"H1715"},{"o":"הוֹבִ֥ישׁ","t":"hoVish","r":"оно имеет высохший вверх","s":"H3001"},{"o":"תִּיר֖וֹשׁ","t":"tiRoosh","r":"новый вино","s":"H8492"},{"o":"אֻמְלַ֥ל","t":"'umLal","r":"оно имеет высохший вне","s":"H0535"},{"o":"יִצְהָֽר\\׃","t":"yitzHar","r":"фреш елей","s":"H3323"}]},{"number":11,"text":"Краснейте от стыда, земледельцы, рыдайте, виноградари, о пшенице и ячмене, потому что погибла жатва в поле,","words":[{"o":"הֹבִ֣ישׁוּ","t":"hoVishu","r":"быть посрамлённый","s":"H0954"},{"o":"אִכָּרִ֗ים","t":"'ikaRim","r":"О фармерс","s":"H0406"},{"o":"הֵילִ֙ילוּ֙","t":"heiLilu","r":"ваил","s":"H3213"},{"o":"כֹּֽרְמִ֔ים","t":"koreMim","r":"О винедрессерс","s":"H3755"},{"o":"עַל\\־","t":"'al-","r":"на","s":"H5921"},{"o":"חִטָּ֖ה","t":"chiTah","r":"пшеница","s":"H2406"},{"o":"וְעַל\\־","t":"ve'al-","r":"и, на","s":"H9002"},{"o":"שְׂעֹרָ֑ה","t":"se'oRah","r":"ячмень","s":"H8184"},{"o":"כִּ֥י","t":"ki","r":"для","s":"H3588"},{"o":"אָבַ֖ד","t":"'aVad","r":"оно имеет погиб","s":"H0006"},{"o":"קְצִ֥יר","t":"keTzir","r":"жатва","s":"H7105"},{"o":"שָׂדֶֽה\\׃","t":"saDeh","r":"поле","s":"H7704"}]},{"number":12,"text":"засохла виноградная лоза и смоковница завяла; гранатовое дерево, пальма и яблоня, все дерева в поле посохли; потому и веселье у сынов человеческих исчезло.","words":[{"o":"הַגֶּ֣פֶן","t":"haGefen","r":"виноградная лоза","s":"H9009"},{"o":"הוֹבִ֔ישָׁה","t":"hoVishah","r":"оно имеет высохший вверх","s":"H0954"},{"o":"וְהַתְּאֵנָ֖ה","t":"vehate'eNah","r":"и, смоква дерево","s":"H9002"},{"o":"אֻמְלָ֑לָה","t":"'umLalah","r":"оно имеет высохший вне","s":"H0535"},{"o":"רִמּ֞וֹן","t":"riMon","r":"помегранате дерево","s":"H7416"},{"o":"גַּם\\־","t":"gam-","r":"также","s":"H1571"},{"o":"תָּמָ֣ר","t":"taMar","r":"ладонь дерево","s":"H8558"},{"o":"וְתַפּ֗וּחַ","t":"vetaPuach","r":"и, аппле дерево","s":"H9002"},{"o":"כָּל\\־","t":"kol-","r":"все","s":"H3605"},{"o":"עֲצֵ֤י","t":"'aTzei","r":"деревья","s":"H6086"},{"o":"הַשָּׂדֶה֙","t":"hasaDeh","r":"поле","s":"H9009"},{"o":"יָבֵ֔שׁוּ","t":"yaVeshu","r":"они имеют высохший вверх","s":"H3001"},{"o":"כִּֽי\\־","t":"ki-","r":"для","s":"H3588"},{"o":"הֹבִ֥ישׁ","t":"hoVish","r":"оно имеет был посрамлённый","s":"H0954"},{"o":"שָׂשׂ֖וֹן","t":"saSon","r":"радость","s":"H8342"},{"o":"מִן\\־","t":"min-","r":"от","s":"H4480"},{"o":"בְּנֵ֥י","t":"beNei","r":"дети","s":"H1121"},{"o":"אָדָֽם\\׃\\ \\ס","t":"'aDam","r":"человечество","s":"H0120"}]},{"number":13,"text":"Препояшьтесь вретищем и плачьте, священники! рыдайте, служители алтаря! войдите, ночуйте во вретищах, служители Бога моего! ибо не стало в доме Бога вашего хлебного приношения и возлияния.","words":[{"o":"חִגְר֨וּ","t":"chigRu","r":"гирд себя","s":"H2296"},{"o":"וְסִפְד֜וּ","t":"vesifDu","r":"и, ламент","s":"H9002"},{"o":"הַכֹּהֲנִ֗ים","t":"hakohaNim","r":"О, священники","s":"H9009"},{"o":"הֵילִ֙ילוּ֙","t":"heiLilu","r":"ваил","s":"H3213"},{"o":"מְשָׁרְתֵ֣י","t":"meshareTei","r":"О рабы","s":"H8334"},{"o":"מִזְבֵּ֔חַ","t":"mizBeach","r":"жертвенник","s":"H4196"},{"o":"בֹּ֚אוּ","t":"Bo'u","r":"прийти","s":"H0935"},{"o":"לִ֣ינוּ","t":"Linu","r":"спенд ночь","s":"H3885"},{"o":"בַשַּׂקִּ֔ים","t":"vasaKim","r":"в, саккклоф<с>","s":"H9003"},{"o":"מְשָׁרְתֵ֖י","t":"meshareTei","r":"О рабы","s":"H8334"},{"o":"אֱלֹהָ֑י","t":"'eloHai","r":"Бог, мой","s":"H0430"},{"o":"כִּ֥י","t":"ki","r":"для","s":"H3588"},{"o":"נִמְנַ֛ע","t":"nimNa'","r":"оно имеет был вифхелд","s":"H4513"},{"o":"מִבֵּ֥ית","t":"miBeit","r":"от, дом","s":"H9006"},{"o":"אֱלֹהֵיכֶ֖ם","t":"'eloheiKhem","r":"Бог, твой","s":"H0430"},{"o":"מִנְחָ֥ה","t":"minChah","r":"зерно приношение","s":"H4503"},{"o":"וָנָֽסֶךְ\\׃","t":"vaNasekh","r":"и, пить приношение","s":"H9002"}]},{"number":14,"text":"Назначьте пост, объявите торжественное собрание, созовите старцев и всех жителей страны сей в дом Господа Бога вашего, и взывайте к Господу.","words":[{"o":"קַדְּשׁוּ\\־","t":"kadeshu-","r":"посвятить","s":"H6942"},{"o":"צוֹם֙","t":"tzOm","r":"пост","s":"H6685"},{"o":"קִרְא֣וּ","t":"kir'U","r":"звать","s":"H7121"},{"o":"עֲצָרָ֔ה","t":"'atzaRah","r":"собрание","s":"H6116"},{"o":"אִסְפ֣וּ","t":"'isFu","r":"собирать","s":"H0622"},{"o":"זְקֵנִ֗ים","t":"zekeNim","r":"старейшины","s":"H2205"},{"o":"כֹּ֚ל","t":"kol","r":"все","s":"H3605"},{"o":"יֹשְׁבֵ֣י","t":"yosheVei","r":"жители","s":"H3427"},{"o":"הָאָ֔רֶץ","t":"ha'Aretz","r":"земля","s":"H9009"},{"o":"בֵּ֖ית","t":"beit","r":"дом","s":"H1004"},{"o":"יְהוָ֣ה","t":"Yahweh","r":"Яхве","s":"H3068"},{"o":"אֱלֹהֵיכֶ֑ם","t":"'eloheiKhem","r":"Бог, твой","s":"H0430"},{"o":"וְזַעֲק֖וּ","t":"veza'aKu","r":"и, вопиять вне","s":"H9002"},{"o":"אֶל\\־","t":"'el-","r":"к","s":"H0413"},{"o":"יְהוָֽה\\׃","t":"Yahweh","r":"Яхве","s":"H3068"}]},{"number":15,"text":"О, какой день! ибо день Господень близок; как опустошение от Всемогущего придет он.","words":[{"o":"אֲהָ֖הּ","t":"'aHah","r":"алас!","s":"H0162"},{"o":"לַיּ֑וֹם","t":"laiYom","r":"для, день","s":"H9005"},{"o":"כִּ֤י","t":"ki","r":"для","s":"H3588"},{"o":"קָרוֹב֙","t":"karOv","r":"есть вблизи","s":"H7138"},{"o":"י֣וֹם","t":"Yom","r":"день","s":"H3117"},{"o":"יְהוָ֔ה","t":"Yahweh","r":"Яхве","s":"H3068"},{"o":"וּכְשֹׁ֖ד","t":"ukheShod","r":"и, как, девастатион","s":"H9002"},{"o":"מִשַׁדַּ֥י","t":"mishaDai","r":"от, Вседержитель","s":"H9006"},{"o":"יָבֽוֹא\\׃","t":"yaVo'","r":"оно будет прийти","s":"H0935"}]},{"number":16,"text":"Не пред нашими ли глазами отнимается пища, от дома Бога нашего - веселье и радость?","words":[{"o":"הֲל֛וֹא","t":"haLo'","r":"¿, не","s":"H9008"},{"o":"נֶ֥גֶד","t":"Neged","r":"перед","s":"H5048"},{"o":"עֵינֵ֖ינוּ","t":"'eiNeinu","r":"глаза, наш","s":"H5869"},{"o":"אֹ֣כֶל","t":"'Okhel","r":"пища","s":"H0400"},{"o":"נִכְרָ֑ת","t":"nikhRat","r":"имеет оно был отрезать прочь","s":"H3772"},{"o":"מִבֵּ֥ית","t":"miBeit","r":"от, дом","s":"H9006"},{"o":"אֱלֹהֵ֖ינוּ","t":"'eloHeinu","r":"Бог, наш","s":"H0430"},{"o":"שִׂמְחָ֥ה","t":"simChah","r":"радость","s":"H8057"},{"o":"וָגִֽיל\\׃","t":"vaGil","r":"и, реджоикинг","s":"H9002"}]},{"number":17,"text":"Истлели зерна под глыбами своими, опустели житницы, разрушены кладовые, ибо не стало хлеба.","words":[{"o":"עָבְשׁ֣וּ","t":"'aveShu","r":"они имеют шривелед","s":"H5685"},{"o":"פְרֻד֗וֹת","t":"feruDot","r":"семена","s":"H6507"},{"o":"תַּ֚חַת","t":"Tachat","r":"под","s":"H8478"},{"o":"מֶגְרְפֹ֣תֵיהֶ֔ם","t":"megreFoteiHem","r":"шовелс, их","s":"H4053"},{"o":"נָשַׁ֙מּוּ֙","t":"naShamu","r":"они есть опустошённый","s":"H8074"},{"o":"אֹֽצָר֔וֹת","t":"'otzaRot","r":"сторехусес","s":"H0214"},{"o":"נֶהֶרְס֖וּ","t":"neherSu","r":"они имеют был разодранный вниз","s":"H2040"},{"o":"מַמְּגֻר֑וֹת","t":"mameguRot","r":"