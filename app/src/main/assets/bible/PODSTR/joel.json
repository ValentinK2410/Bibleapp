vekhaLah","r":"и, бриде","s":"H9002"},{"o":"מֵחֻפָּתָֽהּ\\׃","t":"mechupaTah","r":"от, чамбер, её","s":"H9006"}]},{"number":17,"text":"Между притвором и жертвенником да плачут священники, служители Господни, и говорят: \"пощади, Господи, народ Твой, не предай наследия Твоего на поругание, чтобы не издевались над ним народы; для чего будут говорить между народами: где Бог их?\"","words":[{"o":"בֵּ֤ין","t":"bein","r":"между","s":"H0996"},{"o":"הָאוּלָם֙","t":"ha'uLam","r":"притвор","s":"H9009"},{"o":"וְלַמִּזְבֵּ֔חַ","t":"velamizBeach","r":"и, к, жертвенник","s":"H9002"},{"o":"יִבְכּוּ֙","t":"yivKu","r":"позволить их плакать","s":"H1058"},{"o":"הַכֹּ֣הֲנִ֔ים","t":"haKohaNim","r":"священники","s":"H9009"},{"o":"מְשָׁרְתֵ֖י","t":"meshareTei","r":"рабы","s":"H8334"},{"o":"יְהוָ֑ה","t":"Yahweh","r":"Яхве","s":"H3068"},{"o":"וְֽיֹאמְר֞וּ","t":"veyomeRu","r":"и, позволить их сказать","s":"H9002"},{"o":"ח֧וּסָה","t":"Chusah","r":"имеют сострадание, !","s":"H2347"},{"o":"יְהוָ֣ה","t":"Yahweh","r":"О Яхве","s":"H3068"},{"o":"עַל\\־","t":"'al-","r":"на","s":"H5921"},{"o":"עַמֶּ֗ךָ","t":"'aMekha","r":"народ, твой","s":"H5971"},{"o":"וְאַל\\־","t":"ve'al-","r":"и, да не","s":"H9002"},{"o":"תִּתֵּ֨ן","t":"tiTen","r":"ты делать","s":"H5414"},{"o":"נַחֲלָתְךָ֤","t":"nachalateKha","r":"наследие, твой","s":"H5159"},{"o":"לְחֶרְפָּה֙","t":"lecherPah","r":"в, поношение","s":"H9005"},{"o":"לִמְשָׁל\\־","t":"limshol-","r":"к, мокк","s":"H9005"},{"o":"בָּ֣ם","t":"bam","r":"на, их","s":"H9003"},{"o":"גּוֹיִ֔ם","t":"goYim","r":"народы","s":"H1471"},{"o":"לָ֚מָּה","t":"Lamah","r":"к, почему?","s":"H9005"},{"o":"יֹאמְר֣וּ","t":"yomeRu","r":"будет народ сказать","s":"H0559"},{"o":"בָֽעַמִּ֔ים","t":"va'aMim","r":"среди, народы","s":"H9003"},{"o":"אַיֵּ֖ה","t":"'aiYeh","r":"где?","s":"H0346"},{"o":"אֱלֹהֵיהֶֽם\\׃","t":"'eloheiHem","r":"есть Бог, их","s":"H0430"}]},{"number":18,"text":"И тогда возревнует Господь о земле Своей, и пощадит народ Свой.","words":[{"o":"וַיְקַנֵּ֥א","t":"vaykaNe'","r":"и, он стал джеалус","s":"H9001"},{"o":"יְהוָ֖ה","t":"Yahweh","r":"Яхве","s":"H3068"},{"o":"לְאַרְצ֑וֹ","t":"le'arTzo","r":"для, земля, его","s":"H9005"},{"o":"וַיַּחְמֹ֖ל","t":"vaiyachMol","r":"и, он имел сострадание","s":"H9001"},{"o":"עַל\\־","t":"'al-","r":"на","s":"H5921"},{"o":"עַמּֽוֹ\\׃","t":"aMo","r":"народ, его","s":"H5971"}]},{"number":19,"text":"И ответит Господь, и скажет народу Своему: вот, Я пошлю вам хлеб и вино и елей, и будете насыщаться ими, и более не отдам вас на поругание народам.","words":[{"o":"וַיַּ֨עַן","t":"vaiYa'an","r":"и, он ответил","s":"H9001"},{"o":"יְהוָ֜ה","t":"Yahweh","r":"Яхве","s":"H3068"},{"o":"וַיֹּ֣אמֶר","t":"vaiYomer","r":"и, он сказал","s":"H9001"},{"o":"לְעַמּ֗וֹ","t":"le'aMo","r":"к, народ, его","s":"H9005"},{"o":"הִנְנִ֨י","t":"hiNi","r":"здесь, я","s":"H2005"},{"o":"שֹׁלֵ֤חַ","t":"shoLeach","r":"есмь о к послать","s":"H7971"},{"o":"לָכֶם֙","t":"laKhem","r":"к, ты","s":"H9005"},{"o":"אֶת\\־","t":"'et-","r":"","s":"H0853"},{"o":"הַדָּגָן֙","t":"hadaGan","r":"зерно","s":"H9009"},{"o":"וְהַתִּיר֣וֹשׁ","t":"vehatiRoosh","r":"и, новый вино","s":"H9002"},{"o":"וְהַיִּצְהָ֔ר","t":"vehaiyitzHar","r":"и, фреш елей","s":"H9002"},{"o":"וּשְׂבַעְתֶּ֖ם","t":"useva'Tem","r":"и, ты будет быть насытившийся","s":"H9001"},{"o":"אֹת֑וֹ","t":"'oTo","r":"с, оно","s":"H0854"},{"o":"וְלֹא\\־","t":"velo'-","r":"и, не","s":"H9002"},{"o":"אֶתֵּ֨ן","t":"'eTen","r":"я будет делать","s":"H5414"},{"o":"אֶתְכֶ֥ם","t":"'etKhem","r":"ты","s":"H0853"},{"o":"ע֛וֹד","t":"od","r":"снова","s":"H5750"},{"o":"חֶרְפָּ֖ה","t":"cherPah","r":"поношение","s":"H2781"},{"o":"בַּגּוֹיִֽם\\׃","t":"bagoYim","r":"среди, народы","s":"H9003"}]},{"number":20,"text":"И пришедшего от севера удалю от вас, и изгоню в землю безводную и пустую, переднее полчище его - в море восточное, а заднее - в море западное, и пойдет от него зловоние, и поднимется от него смрад, так как он много наделал зла.","words":[{"o":"וְֽאֶת\\־","t":"ve'Et","r":"и","s":"H9002"},{"o":"הַצְּפוֹנִ֞י","t":"hatzefoNi","r":"норфернерс","s":"H9009"},{"o":"אַרְחִ֣יק","t":"'arChik","r":"я будет удалить далеко прочь","s":"H7368"},{"o":"מֵעֲלֵיכֶ֗ם","t":"me'aleiKhem","r":"от, с, ты","s":"H9006"},{"o":"וְהִדַּחְתִּיו֮","t":"vehidachTiv","r":"и, я будет гнать прочь, оно","s":"H9001"},{"o":"אֶל\\־","t":"'el-","r":"в","s":"H0413"},{"o":"אֶ֣רֶץ","t":"'Eretz","r":"земля","s":"H0776"},{"o":"צִיָּ֣ה","t":"tziYah","r":"сухой","s":"H6723"},{"o":"וּשְׁמָמָה֒","t":"ushemaMah","r":"и, запустение","s":"H9002"},{"o":"אֶת\\־","t":"'et-","r":"","s":"H0853"},{"o":"פָּנָ֗יו","t":"paNav","r":"лицо, его","s":"H6440"},{"o":"אֶל\\־","t":"'el-","r":"в","s":"H0413"},{"o":"הַיָּם֙","t":"haiYam","r":"море","s":"H9009"},{"o":"הַקַּדְמֹנִ֔י","t":"hakadmoNi","r":"еастерн","s":"H9009"},{"o":"וְסֹפ֖וֹ","t":"vesoFo","r":"и, конец, его","s":"H9002"},{"o":"אֶל\\־","t":"'el-","r":"в","s":"H0413"},{"o":"הַיָּ֣ם","t":"haiYam","r":"море","s":"H9009"},{"o":"הָאַֽחֲר֑וֹן","t":"ha'achaRon","r":"вестерн","s":"H9009"},{"o":"וְעָלָ֣ה","t":"ve'aLah","r":"и, оно будет идти вверх","s":"H9001"},{"o":"בָאְשׁ֗וֹ","t":"va'eSho","r":"стенч, его","s":"H0889"},{"o":"וְתַ֙עַל֙","t":"veTa'al","r":"и, оно будет идти вверх","s":"H9002"},{"o":"צַחֲנָת֔וֹ","t":"tzachanaTo","r":"фул смелл, его","s":"H6709"},{"o":"כִּ֥י","t":"ki","r":"для","s":"H3588"},{"o":"הִגְדִּ֖יל","t":"higDil","r":"он имеет сделал великий","s":"H1431"},{"o":"לַעֲשֽׂוֹת\\׃","t":"la'aSot","r":"к, делать","s":"H9005"}]},{"number":21,"text":"Не бойся, земля: радуйся и веселись, ибо Господь велик, чтобы совершить это.","words":[{"o":"אַל\\־","t":"'al-","r":"да не","s":"H0408"},{"o":"תִּֽירְאִ֖י","t":"tir'I","r":"ты страх","s":"H3372"},{"o":"אֲדָמָ֑ה","t":"'adaMah","r":"О земля","s":"H0127"},{"o":"גִּ֣ילִי","t":"Gili","r":"быть рад","s":"H1523"},{"o":"וּשְׂמָ֔חִי","t":"useMachi","r":"и, радоваться","s":"H9002"},{"o":"כִּֽי\\־","t":"ki-","r":"для","s":"H3588"},{"o":"הִגְדִּ֥יל","t":"higDil","r":"он имеет сделал великий","s":"H1431"},{"o":"יְהוָ֖ה","t":"Yahweh","r":"Яхве","s":"H3068"},{"o":"לַעֲשֽׂוֹת\\׃","t":"la'aSot","r":"к, делать","s":"H9005"}]},{"number":22,"text":"Не бойтесь, животные, ибо пастбища пустыни произрастят траву, дерево принесет плод свой, смоковница и виноградная лоза окажут свою силу.","words":[{"o":"אַל\\־","t":"'al-","r":"да не","s":"H0408"},{"o":"תִּֽירְאוּ֙","t":"tire'U","r":"ты страх","s":"H3372"},{"o":"בַּהֲמ֣וֹת","t":"bahaMot","r":"О животные","s":"H0929"},{"o":"שָׂדַ֔י","t":"saDai","r":"поле","s":"H7704"},{"o":"כִּ֥י","t":"ki","r":"для","s":"H3588"},{"o":"דָשְׁא֖וּ","t":"dashe'U","r":"они есть зелёный","s":"H1876"},{"o":"נְא֣וֹת","t":"ne'ot","r":"пастбища","s":"H4999"},{"o":"מִדְבָּ֑ר","t":"midBar","r":"пустыня","s":"H4057"},{"o":"כִּֽי\\־","t":"ki-","r":"для","s":"H3588"},{"o":"עֵץ֙","t":"'etz","r":"деревья","s":"H6086"},{"o":"נָשָׂ֣א","t":"naSa'","r":"оно имеет рождённый","s":"H5375"},{"o":"פִרְי֔וֹ","t":"firYo","r":"плод, его","s":"H6529"},{"o":"תְּאֵנָ֥ה","t":"te'eNah","r":"смоква дерево","s":"H8384"},{"o":"וָגֶ֖פֶן","t":"vaGefen","r":"и, виноградная лоза","s":"H9002"},{"o":"נָתְנ֥וּ","t":"nateNu","r":"они имеют данный","s":"H5414"},{"o":"חֵילָֽם\\׃","t":"cheiLam","r":"сила, их","s":"H2428"}]},{"number":23,"text":"И вы, чада Сиона, радуйтесь и веселитесь о Господе Боге вашем; ибо Он даст вам дождь в меру и будет ниспосылать вам дождь, дождь ранний и поздний, как прежде.","words":[{"o":"וּבְנֵ֣י","t":"uveNei","r":"и, О народ","s":"H9002"},{"o":"צִיּ֗וֹן","t":"tziYon","r":"Сион","s":"H6726"},{"o":"גִּ֤ילוּ","t":"Gilu","r":"быть рад","s":"H1523"},{"o":"וְשִׂמְחוּ֙","t":"vesimChu","r":"и, радоваться","s":"H9002"},{"o":"בַּיהוָ֣ה","t":"baYahweh","r":"в, Яхве","s":"H9003"},{"o":"אֱלֹֽהֵיכֶ֔ם","t":"'eloheiKhem","r":"Бог, твой","s":"H0430"},{"o":"כִּֽי\\־","t":"ki-","r":"для","s":"H3588"},{"o":"נָתַ֥ן","t":"naTan","r":"он имеет данный","s":"H5414"},{"o":"לָכֶ֛ם","t":"laKhem","r":"к, ты","s":"H9005"},{"o":"אֶת\\־","t":"'et-","r":"","s":"H0853"},{"o":"הַמּוֹרֶ֖ה","t":"hamoReh","r":"рано дождь","s":"H9009"},{"o":"לִצְדָקָ֑ה","t":"litzdaKah","r":"для, праведность","s":"H9005"},{"o":"וַיּ֣וֹרֶד","t":"vaiYored","r":"и, он имеет послал вниз","s":"H9001"},{"o":"לָכֶ֗ם","t":"laKhem","r":"для, ты","s":"H9005"},{"o":"גֶּ֛שֶׁם","t":"Geshem","r":"дождь","s":"H1653"},{"o":"מוֹרֶ֥ה","t":"moReh","r":"рано дождь","s":"H4175"},{"o":"וּמַלְק֖וֹשׁ","t":"umalKoosh","r":"и, источник дождь","s":"H9002"},{"o":"בָּרִאשֽׁוֹן\\׃","t":"bariShon","r":"в, первый месяц","s":"H9003"}]},{"number":24,"text":"И наполнятся гумна хлебом, и переполнятся подточилия виноградным соком и елеем.","words":[{"o":"וּמָלְא֥וּ","t":"umal'U","r":"и, они будет быть полный","s":"H9001"},{"o":"הַגֳּרָנ֖וֹת","t":"hagoraNot","r":"гумно пол","s":"H9009"},{"o":"בָּ֑ר","t":"Bar","r":"зерно","s":"H1250"},{"o":"וְהֵשִׁ֥יקוּ","t":"veheShiku","r":"и, они будет оверфлов","s":"H9001"},{"o":"הַיְקָבִ֖ים","t":"haykaVim","r":"вине-вац","s":"H9009"},{"o":"תִּיר֥וֹשׁ","t":"tiRoosh","r":"новый вино","s":"H8492"},{"o":"וְיִצְהָֽר\\׃","t":"veyitzHar","r":"и, фреш елей","s":"H9002"}]},{"number":25,"text":"И воздам вам за те годы, которые пожирали саранча, черви, жуки и гусеница, великое войско Мое, которое послал Я на вас.","words":[{"o":"וְשִׁלַּמְתִּ֤י","t":"veshilamTi","r":"и, я будет восстановить","s":"H9001"},{"o":"לָכֶם֙","t":"laKhem","r":"к, ты","s":"H9005"},{"o":"אֶת\\־","t":"'et-","r":"","s":"H0853"},{"o":"הַשָּׁנִ֔ים","t":"hashaNim","r":"годы","s":"H9009"},{"o":"אֲשֶׁר֙","t":"'aSher","r":"который","s":"H0834"},{"o":"אָכַ֣ל","t":"'aKhal","r":"оно имеет съеденный","s":"H0398"},{"o":"הָֽאַרְבֶּ֔ה","t":"ha'arBeh","r":"саранча","s":"H9009"},{"o":"הַיֶּ֖לֶק","t":"haiYelek","r":"саранча","s":"H9009"},{"o":"וְהֶחָסִ֣יל","t":"vehechaSil","r":"и, саранча","s":"H9002"},{"o":"וְהַגָּזָ֑ם","t":"vehagaZam","r":"и, саранча","s":"H9002"},{"o":"חֵילִי֙","t":"cheiLi","r":"войско, мой","s":"H2428"},{"o":"הַגָּד֔וֹל","t":"hagaDol","r":"великий","s":"H9009"},{"o":"אֲשֶׁ֥ר","t":"'aSher","r":"который","s":"H0834"},{"o":"שִׁלַּ֖חְתִּי","t":"shiLachti","r":"я послал","s":"H7971"},{"o":"בָּכֶֽם\\׃","t":"baKhem","r":"среди, ты","s":"H9003"}]},{"number":26,"text":"И до сытости будете есть и насыщаться и славить имя Господа Бога вашего, Который дивное соделал с вами, и не посрамится народ Мой во веки.","words":[{"o":"וַאֲכַלְתֶּ֤ם","t":"va'akhalTem","r":"и, ты будет есть","s":"H9001"},{"o":"אָכוֹל֙","t":"'akhOl","r":"комплетелй к есть","s":"H0398"},{"o":"וְשָׂב֔וֹעַ","t":"vesaVoa'","r":"и, будучи насытившийся","s":"H9002"},{"o":"וְהִלַּלְתֶּ֗ם","t":"vehilalTem","r":"и, ты будет хвала","s":"H9001"},{"o":"אֶת\\־","t":"'et-","r":"","s":"H0853"},{"o":"שֵׁ֤ם","t":"shem","r":"имя","s":"H8034"},{"o":"יְהוָה֙","t":"Yahweh","r":"Яхве","s":"H3068"},{"o":"אֱלֹ֣הֵיכֶ֔ם","t":"'eLoheiKhem","r":"Бог, твой","s":"H0430"},{"o":"אֲשֶׁר\\־","t":"'aSher-","r":"кто","s":"H0834"},{"o":"עָשָׂ֥ה","t":"'aSah","r":"он имеет деалт","s":"H6213"},{"o":"עִמָּכֶ֖ם","t":"'imaKhem","r":"с, ты","s":"H5973"},{"o":"לְהַפְלִ֑יא","t":"lehafLi'","r":"через, делая вондерфуллй","s":"H9005"},{"o":"וְלֹא\\־","t":"velo'-","r":"и, не","s":"H9002"},{"o":"יֵבֹ֥שׁוּ","t":"yeVoshu","r":"они будет быть посрамлённый","s":"H0954"},{"o":"עַמִּ֖י","t":"'aMi","r":"народ, мой","s":"H5971"},{"o":"לְעוֹלָֽם\\׃","t":"le'oLam","r":"для, когда-либо","s":"H9005"}]},{"number":27,"text":"И узнаете, что Я посреди Израиля, и Я - Господь Бог ваш, и нет другого, и Мой народ не посрамится вовеки.","words":[{"o":"וִידַעְתֶּ֗ם","t":"vida'Tem","r":"и, ты будет знать","s":"H9001"},{"o":"כִּ֣י","t":"ki","r":"что","s":"H3588"},{"o":"בְקֶ֤רֶב","t":"veKerev","r":"есмь в, среда","s":"H9003"},{"o":"יִשְׂרָאֵל֙","t":"Yisra'El","r":"Израиль","s":"H3478"},{"o":"אָ֔נִי","t":"'Ani","r":"я","s":"H0589"},{"o":"וַאֲנִ֛י","t":"va'aNi","r":"и, я","s":"H9002"},{"o":"יְהוָ֥ה","t":"Yahweh","r":"есмь Яхве","s":"H3068"},{"o":"אֱלֹהֵיכֶ֖ם","t":"'eloheiKhem","r":"Бог, твой","s":"H0430"},{"o":"וְאֵ֣ין","t":"ve'Ein","r":"и, там не","s":"H9002"},{"o":"ע֑וֹד","t":"od","r":"есть ещё","s":"H5750"},{"o":"וְלֹא\\־","t":"vel