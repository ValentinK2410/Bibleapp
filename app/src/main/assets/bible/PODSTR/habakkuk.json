ה","t":"tihYeh","r":"оно есть","s":"H1961"},{"o":"קַרְנַ֥יִם","t":"karNayim","r":"два рога","s":"H7161"},{"o":"מִיָּד֖וֹ","t":"miyaDo","r":"от, рука, его","s":"H9006"},{"o":"ל֑וֹ","t":"lo","r":"принадлежать к, его","s":"H9005"},{"o":"וְשָׁ֖ם","t":"veSham","r":"и, есть там","s":"H9002"},{"o":"חֶבְי֥וֹן","t":"chevYon","r":"скрывая место","s":"H2253"},{"o":"עֻזּֽוֹ\\׃","t":"'uZo","r":"сила, его","s":"H5797"}]},{"number":5,"text":"Пред лицем Его идет язва, а по стопам Его - жгучий ветер.","words":[{"o":"לְפָנָ֖יו","t":"lefaNav","r":"к, перед, его","s":"H9005"},{"o":"יֵ֣לֶךְ","t":"Yelekh","r":"оно идёт","s":"H1980"},{"o":"דָּ֑בֶר","t":"Daver","r":"мор","s":"H1698"},{"o":"וְיֵצֵ֥א","t":"veyeTze'","r":"так, оно да идти вне","s":"H9002"},{"o":"רֶ֖שֶׁף","t":"Reshef","r":"молния","s":"H7565"},{"o":"לְרַגְלָֽיו\\׃","t":"leragLav","r":"к, ноги, его","s":"H9005"}]},{"number":6,"text":"Он стал и поколебал землю; воззрел, и в трепет привел народы; вековые горы распались, первобытные холмы опали; пути Его вечные.","words":[{"o":"עָמַ֣ד\\׀","t":"'aMad","r":"он стоял","s":"H5975"},{"o":"וַיְמֹ֣דֶד","t":"vayModed","r":"и, он шук","s":"H9001"},{"o":"אֶ֗רֶץ","t":"'Eretz","r":"земля","s":"H0776"},{"o":"רָאָה֙","t":"ra'Ah","r":"он имеет виденное","s":"H7200"},{"o":"וַיַּתֵּ֣ר","t":"vaiyaTer","r":"и, он имеет сделал прыгать","s":"H9001"},{"o":"גּוֹיִ֔ם","t":"goYim","r":"народы","s":"H1471"},{"o":"וַיִּתְפֹּֽצְצוּ֙","t":"vaiyitpotzeTzu","r":"и, они имеют был шаттеред","s":"H9001"},{"o":"הַרְרֵי\\־","t":"harei-","r":"горы","s":"H2042"},{"o":"עַ֔ד","t":"'Ad","r":"древность","s":"H5703"},{"o":"שַׁח֖וּ","t":"shaChu","r":"они имеют поклонился вниз","s":"H7817"},{"o":"גִּבְע֣וֹת","t":"giv'ot","r":"холмы","s":"H1389"},{"o":"עוֹלָ֑ם","t":"oLam","r":"древность","s":"H5769"},{"o":"הֲלִיכ֥וֹת","t":"haliKhot","r":"пути","s":"H1979"},{"o":"עוֹלָ֖ם","t":"oLam","r":"древность","s":"H5769"},{"o":"לֽוֹ\\׃","t":"lo","r":"принадлежать к, его","s":"H9005"}]},{"number":7,"text":"Грустными видел я шатры Ефиопски