"t":"shevu'ot","r":"клятвы","s":"H7621"},{"o":"מַטּ֖וֹת","t":"maTot","r":"стрелы","s":"H4294"},{"o":"אֹ֣מֶר","t":"'Omer","r":"слово","s":"H0562"},{"o":"סֶ֑לָה","t":"Selah","r":"Селах","s":"H5542"},{"o":"נְהָר֖וֹת","t":"nehaRot","r":"реки","s":"H5104"},{"o":"תְּבַקַּע\\־","t":"tevaka'-","r":"ты сплит открыть","s":"H1234"},{"o":"אָֽרֶץ\\׃","t":"'Aretz","r":"земля","s":"H0776"}]},{"number":10,"text":"Увидев Тебя, вострепетали горы, ринулись воды; бездна дала голос свой, высоко подняла руки свои;","words":[{"o":"רָא֤וּךָ","t":"ra'Ukha","r":"они имеют виденное, ты","s":"H7200"},{"o":"יָחִ֙ילוּ֙","t":"yaChilu","r":"они врифе","s":"H2342"},{"o":"הָרִ֔ים","t":"haRim","r":"горы","s":"H2022"},{"o":"זֶ֥רֶם","t":"Zerem","r":"довнпур","s":"H2230"},{"o":"מַ֖יִם","t":"Mayim","r":"вода","s":"H4325"},{"o":"עָבָ֑ר","t":"'aVar","r":"оно имеет прошёл над","s":"H5674"},{"o":"נָתַ֤ן","t":"naTan","r":"оно имеет данный вперёд","s":"H5414"},{"o":"תְּהוֹם֙","t":"tehOm","r":"глубокий","s":"H8415"},{"o":"קוֹל֔וֹ","t":"koLo","r":"голос, его","s":"H6963"},{"o":"ר֖וֹם","t":"Rom","r":"высота","s":"H7315"},{"o":"יָדֵ֥יהוּ","t":"yaDeihu","r":"руки, его","s":"H3027"},{"o":"נָשָֽׂא\\׃","t":"naSa'","r":"оно имеет поднял","s":"H5375"}]},{"number":11,"text":"солнце и луна остановились на месте своем пред светом летающих стрел Твоих, пред сиянием сверкающих копьев Твоих.","words":[{"o":"שֶׁ֥מֶשׁ","t":"Shemesh","r":"солнце","s":"H8121"},{"o":"יָרֵ֖חַ","t":"yaReach","r":"луна","s":"H3394"},{"o":"עָ֣מַד","t":"'Amad","r":"оно имеет стоял ещё","s":"H5975"},{"o":"זְבֻ֑לָה","t":"zeVulah","r":"лофтй абоде, к","s":"H2073"},{"o":"לְא֤וֹר","t":"le'or","r":"к, свет","s":"H9005"},{"o":"חִצֶּ֙יךָ֙","t":"chiTzeikha","r":"стрелы, твой","s":"H2671"},{"o":"יְהַלֵּ֔כוּ","t":"yehaLekhu","r":"они идти","s":"H1980"},{"o":"לְנֹ֖גַהּ","t":"leNogah","r":"к, бригхтнесс","s":"H9005"},{"o":"בְּרַ֥ק","t":"beRak","r":"молния флаш","s":"H1300"},{"o":"חֲנִיתֶֽךָ\\׃","t":"chaniTekha","r":"копьё, твой","s":"H2595"}]},{"number":12,"text":"Во гневе шествуешь Ты по земле и в негодовании попираешь народы.","words":[{"o":"בְּזַ֖עַם","t":"beZa'am","r":"в, индигнатион","s":"H9003"},{"o":"תִּצְעַד\\־","t":"titz'ad-","r":"ты марч","s":"H6805"},{"o":"אָ֑רֶץ","t":"'Aretz","r":"земля","s":"H0776"},{"o":"בְּאַ֖ף","t":"be'Af","r":"в, гнев","s":"H9003"},{"o":"תָּד֥וּשׁ","t":"taDush","r":"ты трампле вниз","s":"H1758"},{"o":"גּוֹיִֽם\\׃","t":"goYim","r":"народы","s":"H1471"}]},{"number":13,"text":"Ты выступаешь для спасения народа Твоего, для спасения помазанного Твоего. Ты сокрушаешь главу нечестивого дома, обнажая его от основания до верха.","words":[{"o":"יָצָ֙אתָ֙","t":"yaTzata","r":"ты имеют ушёл вне","s":"H3318"},{"o":"לְיֵ֣שַׁע","t":"leYesha'","r":"для, спасение","s":"H9005"},{"o":"עַמֶּ֔ךָ","t":"'aMekha","r":"народ, твой","s":"H5971"},{"o":"לְיֵ֖שַׁע","t":"leYesha'","r":"для, спасение","s":"H9005"},{"o":"אֶת\\־","t":"'et-","r":"","s":"H0853"},{"o":"מְשִׁיחֶ֑ךָ","t":"meshiChekha","r":"помазанный, твой","s":"H4899"},{"o":"מָחַ֤צְתָּ","t":"maChatzta","r":"ты имеют шаттеред","s":"H4272"},{"o":"רֹּאשׁ֙","t":"roSh","r":"начальник","s":"H7218"},{"o":"מִבֵּ֣ית","t":"miBeit","r":"от, дом","s":"H9006"},{"o":"רָשָׁ֔ע","t":"raSha'","r":"нечестивый","s":"H7563"},{"o":"עָר֛וֹת","t":"aRot","r":"ты имеют положил баре","s":"H6168"},{"o":"יְס֥וֹד","t":"yeSod","r":"основания","s":"H3247"},{"o":"עַד\\־","t":"'ad-","r":"к","s":"H5704"},{"o":"צַוָּ֖אר","t":"tzaVar","r":"шея","s":"H6677"},{"o":"סֶֽלָה\\׃\\ \\פ","t":"Selah","r":"Селах","s":"H5542"}]},{"number":14,"text":"Ты пронзаешь копьями его главу вождей его, когда они как вихрь ринулись разбить меня, в радости, как бы думая поглотить бедного скрытно.","words":[{"o":"נָקַ֤בְתָּ","t":"naKavta","r":"ты пиеркед","s":"H5344"},{"o":"בְמַטָּיו֙","t":"vemaTav","r":"с, свой стрелы, его","s":"H9003"},{"o":"רֹ֣אשׁ","t":"rosh","r":"голова","s":"H7218"},{"o":"פְּרָזָ֔יו","t":"perazov","r":"воины, его","s":"H6518"},{"o":"יִסְעֲר֖וּ","t":"yis'aRu","r":"они буря","s":"H5590"},{"o":"לַהֲפִיצֵ֑