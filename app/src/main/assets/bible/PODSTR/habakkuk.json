t":"la'aLot","r":"к, прийти вверх","s":"H9005"},{"o":"לְעַ֥ם","t":"le'Am","r":"к, народ","s":"H9005"},{"o":"יְגוּדֶֽנּוּ\\׃","t":"yeguDenu","r":"который аттаккс нас, оно","s":"H1464"}]},{"number":17,"text":"Хотя бы не расцвела смоковница и не было плода на виноградных лозах, и маслина изменила, и нива не дала пищи, хотя бы не стало овец в загоне и рогатого скота в стойлах, -","words":[{"o":"כִּֽי\\־","t":"ki-","r":"для","s":"H3588"},{"o":"תְאֵנָ֣ה","t":"te'eNah","r":"смоква дерево","s":"H8384"},{"o":"לֹֽא\\־","t":"lo'-","r":"не","s":"H3808"},{"o":"תִפְרָ֗ח","t":"tifRach","r":"оно будс","s":"H6524"},{"o":"וְאֵ֤ין","t":"ve'Ein","r":"и, там не","s":"H9002"},{"o":"יְבוּל֙","t":"yeVul","r":"есть произвести","s":"H2981"},{"o":"בַּגְּפָנִ֔ים","t":"bagefaNim","r":"на, виноградная лоза","s":"H9003"},{"o":"כִּחֵשׁ֙","t":"kiChesh","r":"оно фаилс","s":"H3584"},{"o":"מַעֲשֵׂה\\־","t":"ma'aseh-","r":"продукт","s":"H4639"},{"o":"זַ֔יִת","t":"Zayit","r":"маслина дерево","s":"H2132"},{"o":"וּשְׁדֵמ֖וֹת","t":"ushedeMot","r":"и, поля","s":"H9002"},{"o":"לֹא\\־","t":"lo'-","r":"не","s":"H3808"},{"o":"עָ֣שָׂה","t":"'Asah","r":"оно произвести","s":"H6213"},{"o":"אֹ֑כֶל","t":"'Okhel","r":"пища","s":"H0400"},{"o":"גָּזַ֤ר","t":"gaZar","r":"кто-то режет прочь","s":"H1504"},{"o":"מִמִּכְלָה֙","t":"mimikhLah","r":"от, фолд","s":"H9006"},{"o":"צֹ֔אן","t":"Tzon","r":"стадо","s":"H6629"},{"o":"וְאֵ֥ין","t":"ve'Ein","r":"и, не","s":"H9002"},{"o":"בָּקָ֖ר","t":"baKar","r":"скот","s":"H1241"},{"o":"בָּרְפָתִֽים\\׃","t":"barefaTim","r":"есть в, сталлс","s":"H9003"}]},{"number":18,"text":"но и тогда я буду радоваться о Господе и веселиться о Боге спасения моего.","words":[{"o":"וַאֲנִ֖י","t":"va'aNi","r":"и, я","s":"H9002"},{"o":"בַּיהוָ֣ה","t":"baYahweh","r":"в, Яхве","s":"H9003"},{"o":"אֶעְל֑וֹזָה","t":"'e'Lozah","r":"я будет ексулт","s":"H5937"},{"o":"אָגִ֖ילָה","t":"'aGilah","r":"я будет радоваться","s":"H1523"},{"o":"בֵּאלֹהֵ֥י","t":"beloHei","r":"в, Бог","s":"H9003"},{"o":"יִשְׁעִֽי\\׃","t":"yish'I","r":"спасение, мой","s":"H3468"}]},{"number":19,"text":"Господь Бог - сила моя: Он сделает ноги мои как у оленя и на высоты мои возведет меня! [Начальнику хора.]","words":[{"o":"יְהוִ֤הּ","t":"Yahweh","r":"Яхве","s":"H3069"},{"o":"אֲדֹנָי֙","t":"'adoNai","r":"Господь","s":"H0136"},{"o":"חֵילִ֔י","t":"cheiLi","r":"есть сила, мой","s":"H2428"},{"o":"וַיָּ֤שֶׂם","t":"vaiYasem","r":"и, он делать","s":"H9001"},{"o":"רַגְלַי֙","t":"ragLai","r":"ноги, мой","s":"H7272"},{"o":"כָּֽאַיָּל֔וֹת","t":"ka'aiyaLot","r":"как, делает","s":"H9004"},{"o":"וְעַ֥ל","t":"ve'Al","r":"и, на","s":"H9002"},{"o":"בָּמוֹתַ֖י","t":"bamoTai","r":"высокий места, мой","s":"H1116"},{"o":"יַדְרִכֵ֑נִי","t":"yadriKheni","r":"он делать треад, меня","s":"H1869"},{"o":"לַמְנַצֵּ֖חַ","t":"lamnaTzeach","r":"к, чоирмастер","s":"H9005"},{"o":"בִּנְגִינוֹתָֽי\\׃","t":"binginoTai","r":"с, стрингед инструменц, мой","s":"H9003"}]}]}]}}