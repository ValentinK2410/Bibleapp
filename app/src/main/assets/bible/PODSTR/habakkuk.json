{"translation":"PODSTR","book":{"id":"habakkuk","name":"Аввакум","chapters":[{"number":1,"verses":[{"number":1,"text":"Пророческое видение, которое видел пророк Аввакум.","words":[{"o":"הַמַּשָּׂא֙","t":"hamaSa'","r":"оракле","s":"H9009"},{"o":"אֲשֶׁ֣ר","t":"'aSher","r":"который","s":"H0834"},{"o":"חָזָ֔ה","t":"chaZah","r":"он увидел","s":"H2372"},{"o":"חֲבַקּ֖וּק","t":"chavaKuk","r":"Аввакум","s":"H2265"},{"o":"הַנָּבִֽיא\\׃","t":"hanaVi'","r":"пророк","s":"H9009"}]},{"number":2,"text":"Доколе, Господи, я буду взывать, и Ты не слышишь, буду вопиять к Тебе о насилии, и Ты не спасаешь?","words":[{"o":"עַד\\־","t":"'ad-","r":"до","s":"H5704"},{"o":"אָ֧נָה","t":"'Anah","r":"когда?","s":"H0575"},{"o":"יְהוָ֛ה","t":"Yahweh","r":"О Яхве","s":"H3068"},{"o":"שִׁוַּ֖עְתִּי","t":"shiVa'ti","r":"имеют я воззвал для помочь","s":"H7768"},{"o":"וְלֹ֣א","t":"veLo'","r":"и, не","s":"H9002"},{"o":"תִשְׁמָ֑ע","t":"tishMa'","r":"ты будет слышать","s":"H8085"},{"o":"אֶזְעַ֥ק","t":"'ez'Ak","r":"я вопиять вне","s":"H2199"},{"o":"אֵלֶ֛יךָ","t":"'eLeikha","r":"к, ты","s":"H0413"},{"o":"חָמָ֖ס","t":"chaMas","r":"насилие","s":"H2555"},{"o":"וְלֹ֥א","t":"veLo'","r":"и, не","s":"H9002"},{"o":"תוֹשִֽׁיעַ\\׃","t":"toShia'","r":"ты спасти","s":"H3467"}]},{"number":3,"text":"Для чего даешь мне видеть злодейство и смотреть на бедствия? Грабительство и насилие предо мною, и восстает вражда и поднимается раздор.","words":[{"o":"לָ֣מָּה","t":"Lamah","r":"к, почему?","s":"H9005"},{"o":"תַרְאֵ֤נִי","t":"tar'Eni","r":"делать ты делать видеть, меня","s":"H7200"},{"o":"אָ֙וֶן֙","t":"'aven","r":"нечестие","s":"H0205"},{"o":"וְעָמָ֣ל","t":"ve'aMal","r":"и, мисчиеф","s":"H9002"},{"o":"תַּבִּ֔יט","t":"taBit","r":"делать ты смотри у?","s":"H5027"},{"o":"וְשֹׁ֥ד","t":"veShod","r":"и, девастатион","s":"H9002"},{"o":"וְחָמָ֖ס","t":"vechaMas","r":"и, насилие","s":"H9002"},{"o":"לְנֶגְדִּ֑י","t":"lenegDi","r":"есть к, перед, меня","s":"H9005"},{"o":"וַיְהִ֧י","t":"vayHi","r":"и, оно имеет был","s":"H9001"},{"o":"רִ֦יב","t":"riv","r":"стрифе","s":"H7379"},{"o":"וּמָד֖וֹן","t":"umaDon","r":"и, контентион","s":"H9002"},{"o":"יִשָּֽׂא\\׃","t":"yiSa'","r":"оно восстать","s":"H5375"}]},{"number":4,"text":"От этого закон потерял силу, и суда правильного нет: так как нечестивый одолевает праведного, то и суд происходит превратный.","words":[{"o":"עַל\\־","t":"'al-","r":"по-","s":"H5921"},{"o":"כֵּן֙","t":"ken","r":"тому","s":"H3651"},{"o":"תָּפ֣וּג","t":"taFug","r":"оно расти нумб","s":"H6313"},{"o":"תּוֹרָ֔ה","t":"toRah","r":"закон","s":"H8451"},{"o":"וְלֹֽא\\־","t":"velo'-","r":"и, не","s":"H9002"},{"o":"יֵצֵ֥א","t":"yeTze'","r":"оно приходит вперёд","s":"H3318"},{"o":"לָנֶ֖צַח","t":"laNetzach","r":"к, вечность","s":"H9005"},{"o":"מִשְׁפָּ֑ט","t":"mishPat","r":"справедливость","s":"H4941"},{"o":"כִּ֤י","t":"ki","r":"для","s":"H3588"},{"o":"רָשָׁע֙","t":"raSha'","r":"нечестивый","s":"H7563"},{"o":"מַכְתִּ֣יר","t":"makhTir","r":"есть суррундинг","s":"H3803"},{"o":"אֶת\\־","t":"'et-","r":"","s":"H0853"},{"o":"הַצַּדִּ֔יק","t":"hatzaDik","r":"праведный лицо","s":"H9009"},{"o":"עַל\\־","t":"'al-","r":"по-","s":"H5921"},{"o":"כֵּ֛ן","t":"ken","r":"тому","s":"H3651"},{"o":"יֵצֵ֥א","t":"yeTze'","r":"оно приходит вперёд","s":"H3318"},{"o":"מִשְׁפָּ֖ט","t":"mishPat","r":"справедливость","s":"H4941"},{"o":"מְעֻקָּֽל\\׃","t":"me'uKal","r":"первертед","s":"H6127"}]},{"number":5,"text":"Посмотрите между народами и внимательно вглядитесь, и вы сильно изумитесь; ибо Я сделаю во дни ваши такое дело, которому вы не поверили бы, если бы вам рассказывали.","words":[{"o":"רְא֤וּ","t":"re'U","r":"видеть","s":"H7200"},{"o":"בַגּוֹיִם֙","t":"vagoYim","r":"среди, народы","s":"H9003"},{"o":"וְֽהַבִּ֔יטוּ","t":"vehaBitu","r":"и, смотри","s":"H9002"},{"o":"וְהִֽתַּמְּה֖וּ","t":"vehittameHu","r":"и, быть астундед","s":"H9002"},{"o":"תְּמָ֑הוּ","t":"teMahu","r":"быть астонишед","s":"H8539"},{"o":"כִּי\\־","t":"ki-","r":"для","s":"H3588"},{"o":"פֹ֙עַל֙","t":"fo'al","r":"деяние","s":"H6467"},{"o":"פֹּעֵ֣ל","t":"po'El","r":"я есмь о к делать","s":"H6466"},{"o":"בִּֽימֵיכֶ֔ם","t":"bimeiKhem","r":"в, дни, твой","s":"H9003"},{"o":"לֹ֥א","t":"lo'","r":"который не","s":"H3808"},{"o":"תַאֲמִ֖ינוּ","t":"ta'aMinu","r":"ты будет верить","s":"H0539"},{"o":"כִּ֥י","t":"ki","r":"если","s":"H3588"},{"o":"יְסֻפָּֽר\\׃","t":"yesuPar","r":"оно будет быть рекунтед","s":"H5608"}]},{"number":6,"text":"Ибо вот, Я подниму Халдеев, народ жестокий и необузданный, который ходит по широтам земли, чтобы завладеть не принадлежащими ему селениями.","words":[{"o":"כִּֽי\\־","t":"ki-","r":"для","s":"H3588"},{"o":"הִנְנִ֤י","t":"hiNi","r":"здесь, я","s":"H2005"},{"o":"מֵקִים֙","t":"meKim","r":"есмь о к поднять вверх","s":"H6965"},{"o":"אֶת\\־","t":"'et-","r":"","s":"H0853"},{"o":"הַכַּשְׂדִּ֔ים","t":"hakasDim","r":"Халдеи","s":"H9009"},{"o":"הַגּ֖וֹי","t":"haGoy","r":"народ","s":"H9009"},{"o":"הַמַּ֣ר","t":"haMar","r":"горький","s":"H9009"},{"o":"וְהַנִּמְהָ֑ר","t":"vehanimHar","r":"и, импетуус","s":"H9002"},{"o":"הַֽהוֹלֵךְ֙","t":"haholeKh","r":"который, идёт","s":"H9009"},{"o":"לְמֶרְחֲבֵי\\־","t":"lemerchavei-","r":"к, експансес","s":"H9005"},{"o":"אֶ֔רֶץ","t":"'Eretz","r":"земля","s":"H0776"},{"o":"לָרֶ֖שֶׁת","t":"laReshet","r":"к, взять владение","s":"H9005"},{"o":"מִשְׁכָּנ֥וֹת","t":"mishkaNot","r":"обитающий","s":"H4908"},{"o":"לֹּא\\־","t":"lo'-","r":"который не","s":"H3808"},{"o":"לֽוֹ\\׃","t":"lo","r":"принадлежать к, оно","s":"H9005"}]},{"number":7,"text":"Страшен и грозен он; от него самого происходит суд его и власть его.","words":[{"o":"אָיֹ֥ם","t":"'aYom","r":"есть террифйинг","s":"H0366"},{"o":"וְנוֹרָ֖א","t":"venoRa'","r":"и, авесоме","s":"H9002"},{"o":"ה֑וּא","t":"Hu'","r":"оно","s":"H1931"},{"o":"מִמֶּ֕נּוּ","t":"miMenu","r":"от, само","s":"H4480"},{"o":"מִשְׁפָּט֥וֹ","t":"mishpaTo","r":"справедливость, его","s":"H4941"},{"o":"וּשְׂאֵת֖וֹ","t":"use'eTo","r":"и, дигнитй, его","s":"H9002"},{"o":"יֵצֵֽא\\׃","t":"yeTze'","r":"оно приходит вперёд","s":"H3318"}]},{"number":8,"text":"Быстрее барсов кони его и прытче вечерних волков; скачет в разные стороны конница его; издалека приходят всадники его, прилетают как орел, бросающийся на добычу.","words":[{"o":"וְקַלּ֨וּ","t":"vekaLu","r":"и, они есть свифт","s":"H9001"},{"o":"מִנְּמֵרִ֜ים","t":"minemeRim","r":"более чем, леопардс","s":"H9006"},{"o":"סוּסָ֗יו","t":"suSav","r":"кони, его","s":"H5483"},{"o":"וְחַדּוּ֙","t":"vechaDu","r":"и, они есть кин","s":"H9001"},{"o":"מִזְּאֵ֣בֵי","t":"mize'Evei","r":"более чем, волвес","s":"H9006"},{"o":"עֶ֔רֶב","t":"'Erev","r":"вечер","s":"H6153"},{"o":"וּפָ֖שׁוּ","t":"uFashu","r":"и, они пав земля","s":"H9001"},{"o":"פָּֽרָשָׁ֑יו","t":"paraShav","r":"вархорсес, его","s":"H6571"},{"o":"וּפָֽרָשָׁיו֙","t":"ufaraShav","r":"и, всадники, его","s":"H9002"},{"o":"מֵרָח֣וֹק","t":"meraChok","r":"от, расстояние","s":"H9006"},{"o":"יָבֹ֔אוּ","t":"yaVo'u","r":"они прийти","s":"H0935"},{"o":"יָעֻ֕פוּ","t":"ya'Ufu","r":"они флй","s":"H5774"},{"o":"כְּנֶ֖שֶׁר","t":"keNesher","r":"как, орёл","s":"H9004"},{"o":"חָ֥שׁ","t":"chash","r":"делая хасте","s":"H2363"},{"o":"לֶאֱכֽוֹל\\׃","t":"le'eKhol","r":"к, поглотить","s":"H9005"}]},{"number":9,"text":"Весь он идет для грабежа; устремив лице свое вперед, он забирает пленников, как песок.","words":[{"o":"כֻּלֹּה֙","t":"kuLoh","r":"все, оно","s":"H3605"},{"o":"לְחָמָ֣ס","t":"lechaMas","r":"для, насилие","s":"H9005"},{"o":"יָב֔וֹא","t":"yaVo'","r":"оно приходит","s":"H0935"},{"o":"מְגַמַּ֥ת","t":"megaMat","r":"тоталитй","s":"H4041"},{"o":"פְּנֵיהֶ֖ם","t":"peneiHem","r":"лицо, их","s":"H6440"},{"o":"קָדִ֑ימָה","t":"kaDimah","r":"есть восток, сторону","s":"H6921"},{"o":"וַיֶּאֱסֹ֥ף","t":"vaiye'eSof","r":"и, оно собрал","s":"H9001"},{"o":"כַּח֖וֹל","t":"kaChol","r":"как, песок","s":"H9004"},{"o":"שֶֽׁבִי\\׃","t":"Shevi","r":"каптивес","s":"H7628"}]},{"number":10,"text":"И над царями он издевается, и князья служат ему посмешищем; над всякою крепостью он смеется: насыплет осадный вал и берет ее.","words":[{"o":"וְהוּא֙","t":"veHu'","r":"и, оно","s":"H9002"},{"o":"בַּמְּלָכִ֣ים","t":"bamelaKhim","r":"в, цари","s":"H9003"},{"o":"יִתְקַלָּ֔ס","t":"yitkaLas","r":"оно деридес","s":"H7046"},{"o":"וְרֹזְנִ֖ים","t":"verozeNim","r":"и, правители","s":"H9002"},{"o":"מִשְׂחָ֣ק","t":"misChak","r":"есть лаугхтер","s":"H4890"},{"o":"ל֑וֹ","t":"lo","r":"к, оно","s":"H9005"},{"o":"ה֚וּא","t":"hu'","r":"оно","s":"H1931"},{"o":"לְכָל\\־","t":"lekhol","r":"у, каждый","s":"H9005"},{"o":"מִבְצָ֣ר","t":"mivTzar","r":"крепость","s":"H4013"},{"o":"יִשְׂחָ֔ק","t":"yisChak","r":"оно лаугхс","s":"H7832"},{"o":"וַיִּצְבֹּ֥ר","t":"vaiyitzBor","r":"и, оно хеапед вверх","s":"H9001"},{"o":"עָפָ֖ר","t":"'aFar","r":"земля","s":"H6083"},{"o":"וַֽיִּלְכְּדָֽהּ\\׃","t":"VaiyilkeDah","r":"и, оно захватил, оно","s":"H9001"}]},{"number":11,"text":"Тогда надмевается дух его, и он ходит и буйствует; сила его - бог его.","words":[{"o":"אָ֣ז","t":"'az","r":"тогда","s":"H0227"},{"o":"חָלַ֥ף","t":"chaLaf","r":"оно свепт на","s":"H2498"},{"o":"ר֛וּחַ","t":"Ruach","r":"ветер","s":"H7307"},{"o":"וַֽיַּעֲבֹ֖ר","t":"vaiya'aVor","r":"и, оно прошёл на","s":"H9001"},{"o":"וְאָשֵׁ֑ם","t":"ve'aShem","r":"и, он есть виновный","s":"H9001"},{"o":"ז֥וּ","t":"zu","r":"один кто","s":"H2098"},{"o":"כֹח֖וֹ","t":"khoCho","r":"сила, его","s":"H3581"},{"o":"לֵאלֹהֽוֹ\\׃","t":"leloHo","r":"становится в, бог, его","s":"H9005"}]},{"number":12,"text":"Но не Ты ли издревле Господь Бог мой, Святый мой? мы не умрем! Ты, Господи, только для суда попустил его. Скала моя! для наказания Ты назначил его.","words":[{"o":"הֲל֧וֹא","t":"haLo'","r":"¿, не","s":"H9008"},{"o":"אַתָּ֣ה","t":"'aTah","r":"есть ты","s":"H0859"},{"o":"מִקֶּ֗דֶם","t":"miKedem","r":"от, древность","s":"H9006"},{"o":"יְהוָ֧ה","t":"Yahweh","r":"О Яхве","s":"H3068"},{"o":"אֱלֹהַ֛י","t":"'eloHai","r":"Бог, мой","s":"H0430"},{"o":"קְדֹשִׁ֖י","t":"kedoShi","r":"святой один, мой","s":"H6918"},{"o":"לֹ֣א","t":"lo'","r":"не","s":"H3808"},{"o":"נָמ֑וּת","t":"naMut","r":"мы будет умереть","s":"H4191"},{"o":"יְהוָה֙","t":"Yahweh","r":"О Яхве","s":"H3068"},{"o":"לְמִשְׁפָּ֣ט","t":"lemishPat","r":"к, суд","s":"H9005"},{"o":"שַׂמְתּ֔וֹ","t":"samTo","r":"ты имеют назначил, оно","s":"H7760"},{"o":"וְצ֖וּר","t":"veTzur","r":"и, О скала","s":"H9002"},{"o":"לְהוֹכִ֥יחַ","t":"lehoKhiach","r":"к, репрове","s":"H9005"},{"o":"יְסַדְתּֽוֹ\\׃","t":"yesadTo","r":"ты имеют установил, оно","s":"H3245"}]},{"number":13,"text":"Чистым очам Твоим не свойственно глядеть на злодеяния, и смотреть на притеснение Ты не можешь; для чего же Ты смотришь на злодеев и безмолвствуешь, когда нечестивец поглощает того, кто праведнее его,","words":[{"o":"טְה֤וֹר","t":"teHor","r":"ты есть тоже чистый","s":"H2890"},{"o":"עֵינַ֙יִם֙","t":"'eiNayim","r":"глаза","s":"H5869"},{"o":"מֵרְא֣וֹת","t":"mere'ot","r":"для, видя","s":"H9006"},{"o":"רָ֔ע","t":"Ra'","r":"зло","s":"H7451"},{"o":"וְהַבִּ֥יט","t":"vehaBit","r":"и, к смотри","s":"H9002"},{"o":"אֶל\\־","t":"'el-","r":"к","s":"H0413"},{"o":"עָמָ֖ל","t":"'aMal","r":"мисчиеф","s":"H5999"},{"o":"לֹ֣א","t":"lo'","r":"не","s":"H3808"},{"o":"תוּכָ֑ל","t":"tuKhal","r":"ты есть способный","s":"H3201"},{"o":"לָ֤מָּה","t":"Lamah","r":"к, почему?","s":"H9005"},{"o":"תַבִּיט֙","t":"taBit","r":"делать ты смотри у","s":"H5027"},{"o":"בּֽוֹגְדִ֔ים","t":"bogDim","r":"треачерус народ","s":"H0898"},{"o":"תַּחֲרִ֕ישׁ","t":"tachaRish","r":"есть ты молчащий?","s":"H2790"},{"o":"בְּבַלַּ֥ע","t":"bevaLa'","r":"когда, поглотить вверх","s":"H9003"},{"o":"רָשָׁ֖ע","t":"raSha'","r":"нечестивый лицо","s":"H7563"},{"o":"צַדִּ֥יק","t":"tzaDik","r":"лицо праведный","s":"H6662"},{"o":"מִמֶּֽנּוּ\\׃","t":"miMenu","r":"более чем, его","s":"H4480"}]},{"number":14,"text":"и оставляешь людей как рыбу в море, как пресмыкающихся, у которых нет властителя?","words":[{"o":"וַתַּעֲשֶׂ֥ה","t":"vata'aSeh","r":"и, ты имеют сделал","s":"H9001"},{"o":"אָדָ֖ם","t":"'aDam","r":"человечество","s":"H0120"},{"o":"כִּדְגֵ֣י","t":"kidGei","r":"как, рыба","s":"H9004"},{"o":"הַיָּ֑ם","t":"haiYam","r":"море","s":"H9009"},{"o":"כְּרֶ֖