{"translation":"PODSTR","book":{"id":"nahum","name":"Наум","chapters":[{"number":1,"verses":[{"number":1,"text":"Пророчество о Ниневии; книга видений Наума Елкосеянина.","words":[{"o":"מַשָּׂ֖א","t":"maSa'","r":"оракле","s":"H4853"},{"o":"נִֽינְוֵ֑ה","t":"ninVeh","r":"Ниневех","s":"H5210"},{"o":"סֵ֧פֶר","t":"Sefer","r":"документ","s":"H5612"},{"o":"חֲז֛וֹן","t":"chaZon","r":"видение","s":"H2377"},{"o":"נַח֖וּם","t":"naChum","r":"Наум","s":"H5151"},{"o":"הָאֶלְקֹשִֽׁי\\׃","t":"ha'elkoShi","r":"Елкошите","s":"H9009"}]},{"number":2,"text":"Господь есть Бог ревнитель и мститель; мститель Господь и страшен в гневе: мстит Господь врагам Своим и не пощадит противников Своих.","words":[{"o":"אֵ֣ל","t":"'el","r":"есть Бог","s":"H0410"},{"o":"קַנּ֤וֹא","t":"kaNo'","r":"джеалус","s":"H7072"},{"o":"וְנֹקֵם֙","t":"venoKem","r":"и, авенгинг","s":"H9002"},{"o":"יְהוָ֔ה","t":"Yahweh","r":"Яхве","s":"H3068"},{"o":"נֹקֵ֥ם","t":"noKem","r":"есть авенгинг","s":"H5358"},{"o":"יְהוָ֖ה","t":"Yahweh","r":"Яхве","s":"H3068"},{"o":"וּבַ֣עַל","t":"uVa'al","r":"и, господин","s":"H9002"},{"o":"חֵמָ֑ה","t":"cheMah","r":"ярость","s":"H2534"},{"o":"נֹקֵ֤ם","t":"noKem","r":"есть авенгинг","s":"H5358"},{"o":"יְהוָה֙","t":"Yahweh","r":"Яхве","s":"H3068"},{"o":"לְצָרָ֔יו","t":"letzaRav","r":"к, оппоненц, его","s":"H9005"},{"o":"וְנוֹטֵ֥ר","t":"venoTer","r":"и, есть маинтаининг","s":"H9002"},{"o":"ה֖וּא","t":"hu'","r":"он","s":"H1931"},{"o":"לְאֹיְבָֽיו\\׃","t":"le'oyeVav","r":"к, враги, его","s":"H9005"}]},{"number":3,"text":"Господь долготерпелив и велик могуществом, и не оставляет без наказания; в вихре и в буре шествие Господа, облако - пыль от ног Его.","words":[{"o":"יְהֹוָ֗ה","t":"Yahweh","r":"Яхве","s":"H3068"},{"o":"אֶ֤רֶךְ","t":"'Erekh","r":"есть долгий","s":"H0750"},{"o":"אַפַּ֙יִם֙","t":"'aPayim","r":"ангер<с>","s":"H0639"},{"o":"וּגְדָל","t":"ugedol-","r":"и, великий","s":"H9002"},{"o":"כֹּ֔חַ","t":"Koach","r":"сила","s":"H3581"},{"o":"וְנַקֵּ֖ה","t":"venaKeh","r":"и, непременно к оставить унпунишед","s":"H9002"},{"o":"לֹ֣א","t":"lo'","r":"не","s":"H3808"},{"o":"יְנַקֶּ֑ה","t":"yenaKeh","r":"он будет оставить унпунишед","s":"H5352"},{"o":"יְהוָ֗ה","t":"Yahweh","r":"Яхве","s":"H3068"},{"o":"בְּסוּפָ֤ה","t":"besuFah","r":"есть в, сторм-винд","s":"H9003"},{"o":"וּבִשְׂעָרָה֙","t":"uvis'aRah","r":"и, в, буря","s":"H9002"},{"o":"דַּרְכּ֔וֹ","t":"darKo","r":"путь, его","s":"H1870"},{"o":"וְעָנָ֖ן","t":"ve'aNan","r":"и, есть облако","s":"H9002"},{"o":"אֲבַ֥ק","t":"'aVak","r":"прах","s":"H0080"},{"o":"רַגְלָֽיו\\׃","t":"ragLav","r":"ноги, его","s":"H7272"}]},{"number":4,"text":"Запретит Он морю, и оно высыхает, и все реки иссякают; вянет Васан и Кармил, и блекнет цвет на Ливане.","words":[{"o":"גּוֹעֵ֤ר","t":"go'Er","r":"он есть ребукинг","s":"H1605"},{"o":"בַּיָּם֙","t":"baiYam","r":"в, море","s":"H9003"},{"o":"וַֽיַּבְּשֵׁ֔הוּ","t":"vaiyabeShehu","r":"и, он сделал сухой, оно","s":"H9001"},{"o":"וְכָל\\־","t":"vekhol","r":"и, все","s":"H9002"},{"o":"הַנְּהָר֖וֹת","t":"hanehaRot","r":"реки","s":"H9009"},{"o":"הֶֽחֱרִ֑יב","t":"hecheRiv","r":"он дриес вверх","s":"H2717"},{"o":"אֻמְלַ֤ל","t":"'umLal","r":"оно виферс","s":"H0535"},{"o":"בָּשָׁן֙","t":"baShan","r":"Васан","s":"H1316"},{"o":"וְכַרְמֶ֔ל","t":"vekharMel","r":"и, Кармел","s":"H9002"},{"o":"וּפֶ֥רַח","t":"uFerach","r":"и, блоссом","s":"H9002"},{"o":"לְבָנ֖וֹן","t":"levaNon","r":"Ливан","s":"H3844"},{"o":"אֻמְלָֽל\\׃","t":"'umLal","r":"оно виферс","s":"H0535"}]},{"number":5,"text":"Горы трясутся пред Ним, и холмы тают, и земля колеблется пред лицем Его, и вселенная и все живущие в ней.","words":[{"o":"הָרִים֙","t":"haRim","r":"горы","s":"H2022"},{"o":"רָעֲשׁ֣וּ","t":"ra'aShu","r":"они куаке","s":"H7493"},{"o":"מִמֶּ֔נּוּ","t":"miMenu","r":"от, его","s":"H4480"},{"o":"וְהַגְּבָע֖וֹת","t":"vehageva'ot","r":"и, холмы","s":"H9002"},{"o":"הִתְמֹגָ֑גוּ","t":"hitmoGagu","r":"они мелт","s":"H4127"},{"o":"וַתִּשָּׂ֤א","t":"vatiSa'","r":"и, оно поднял вверх","s":"H9001"},{"o":"הָאָ֙רֶץ֙","t":"ha'Aretz","r":"земля","s":"H9009"},{"o":"מִפָּנָ֔יו","t":"mipaNav","r":"от, перед, его","s":"H9006"},{"o":"וְתֵבֵ֖ל","t":"veteVel","r":"и, мир","s":"H9002"},{"o":"וְכָל\\־","t":"vekhol","r":"и, все","s":"H9002"},{"o":"יֹ֥שְׁבֵי","t":"Yoshevei","r":"те кто обитать","s":"H3427"},{"o":"בָֽהּ\\׃","t":"Vah","r":"в, оно","s":"H9003"}]},{"number":6,"text":"Пред негодованием Его кто устоит? И кто стерпит пламя гнева Его? Гнев Его разливается как огонь; скалы распадаются пред Ним.","words":[{"o":"לִפְנֵ֤י","t":"lifNei","r":"к, перед","s":"H9005"},{"o":"זַעְמוֹ֙","t":"za'Mo","r":"индигнатион, его","s":"H2195"},{"o":"מִ֣י","t":"mi","r":"кто?","s":"H4310"},{"o":"יַֽעֲמ֔וֹד","t":"ya'aMod","r":"будет он стоять","s":"H5975"},{"o":"וּמִ֥י","t":"uMi","r":"и, кто?","s":"H9002"},{"o":"יָק֖וּם","t":"yaKum","r":"будет он ендуре","s":"H6965"},{"o":"בַּחֲר֣וֹן","t":"bachaRon","r":"у, горящий","s":"H9003"},{"o":"אַפּ֑וֹ","t":"'aPo","r":"гнев, его","s":"H0639"},{"o":"חֲמָתוֹ֙","t":"chamaTo","r":"ярость, его","s":"H2534"},{"o":"נִתְּכָ֣ה","t":"niteKhah","r":"оно есть вылил вне","s":"H5413"},{"o":"כָאֵ֔שׁ","t":"kha'Esh","r":"как, огонь","s":"H9004"},{"o":"וְהַצֻּרִ֖ים","t":"vehatzuRim","r":"и, скалы","s":"H9002"},{"o":"נִתְּצ֥וּ","t":"niteTzu","r":"они есть пуллед вниз","s":"H5422"},{"o":"מִמֶּֽנּוּ\\׃","t":"miMenu","r":"от, его","s":"H4480"}]},{"number":7,"text":"Благ Господь, убежище в день скорби, и знает надеющихся на Него.","words":[{"o":"ט֣וֹב","t":"Tov","r":"есть хороший","s":"H2896"},{"o":"יְהוָ֔ה","t":"Yahweh","r":"Яхве","s":"H3068"},{"o":"לְמָע֖וֹז","t":"lema'oz","r":"в, убежище","s":"H9005"},{"o":"בְּי֣וֹם","t":"beYom","r":"в, день","s":"H9003"},{"o":"צָרָ֑ה","t":"tzaRah","r":"беда","s":"H6869"},{"o":"וְיֹדֵ֖עַ","t":"veyoDea'","r":"и, он есть зная","s":"H9002"},{"o":"חֹ֥סֵי","t":"Chosei","r":"те кто взять убежище","s":"H2620"},{"o":"בֽוֹ\\׃","t":"vo","r":"в, его","s":"H9003"}]},{"number":8,"text":"Но всепотопляющим наводнением разрушит до основания Ниневию, и врагов Его постигнет мрак.","words":[{"o":"וּבְשֶׁ֣טֶף","t":"uveShetef","r":"и, с, потоп","s":"H9002"},{"o":"עֹבֵ֔ר","t":"'oVer","r":"который пройти над","s":"H5674"},{"o":"כָּלָ֖ה","t":"kaLah","r":"завершённый разрушение","s":"H3617"},{"o":"יַעֲשֶׂ֣ה","t":"ya'aSeh","r":"он будет делать","s":"H6213"},{"o":"מְקוֹמָ֑הּ","t":"mekoMah","r":"место, его","s":"H4725"},{"o":"וְאֹיְבָ֖יו","t":"ve'oyeVav","r":"и, враги, его","s":"H9002"},{"o":"יְרַדֶּף\\־","t":"yeradef-","r":"он будет преследовать","s":"H7291"},{"o":"חֹֽשֶׁךְ\\׃","t":"Choshekh","r":"тьма","s":"H2822"}]},{"number":9,"text":"Что умышляете вы против Господа? Он совершит истребление, и бедствие уже не повторится,","words":[{"o":"מַה\\־","t":"mah-","r":"что бы ни","s":"H4100"},{"o":"תְּחַשְּׁבוּן֙","t":"techasheVun","r":"ты будет плот, !","s":"H2803"},{"o":"אֶל\\־","t":"'el-","r":"против","s":"H0413"},{"o":"יְהוָ֔ה","t":"Yahweh","r":"Яхве","s":"H3068"},{"o":"כָּלָ֖ה","t":"kaLah","r":"завершённый разрушение","s":"H3617"},{"o":"ה֣וּא","t":"hu'","r":"он","s":"H1931"},{"o":"עֹשֶׂ֑ה","t":"'oSeh","r":"будет быть делая","s":"H6213"},{"o":"לֹֽא\\־","t":"lo'-","r":"не","s":"H3808"},{"o":"תָק֥וּם","t":"taKum","r":"оно будет восстать","s":"H6965"},{"o":"פַּעֲמַ֖יִם","t":"pa'aMayim","r":"два времена","s":"H6471"},{"o":"צָרָֽה\\׃","t":"tzaRah","r":"беда","s":"H6869"}]},{"number":10,"text":"ибо сплетшиеся между собою как терновник и упившиеся как пьяницы, они пожраны будут совершенно, как сухая солома.","words":[{"o":"כִּ֚י","t":"ki","r":"для","s":"H3588"},{"o":"עַד\\־","t":"'ad-","r":"к","s":"H5704"},{"o":"סִירִ֣ים","t":"siRim","r":"тернии","s":"H5518"},{"o":"סְבֻכִ֔ים","t":"sevuKhim","r":"интервовен","s":"H5440"},{"o":"וּכְסָבְאָ֖ם","t":"ukhesave'Am","r":"и, как, пить, их","s":"H9002"},{"o":"סְבוּאִ֑ים","t":"sevu'Im","r":"дрункардс","s":"H5433"},{"o":"אֻ֨כְּל֔וּ","t":"'ukeLu","r":"они будет быть поглощён","s":"H0398"},{"o":"כְּקַ֥שׁ","t":"keKash","r":"как, стуббле","s":"H9004"},{"o":"יָבֵ֖שׁ","t":"yaVesh","r":"сухой","s":"H3002"},{"o":"מָלֵֽא\\׃","t":"maLe'","r":"полный","s":"H4392"}]},{"number":11,"text":"Из тебя произошел умысливший злое против Господа, составивший совет нечестивый.","words":[{"o":"מִמֵּ֣ךְ","t":"miMekh","r":"от, ты","s":"H4480"},{"o":"יָצָ֔א","t":"yaTza'","r":"он имеет прийти вне","s":"H3318"},{"o":"חֹשֵׁ֥ב","t":"choShev","r":"один кто плоц","s":"H2803"},{"o":"עַל\\־","t":"'al-","r":"на","s":"H5921"},{"o":"יְהוָ֖ה","t":"Yahweh","r":"Яхве","s":"H3068"},{"o":"רָעָ֑ה","t":"ra'Ah","r":"зло","s":"H7451"},{"o":"יֹעֵ֖ץ","t":"yo'Etz","r":"кунселор","s":"H3289"},{"o":"בְּלִיָּֽעַל\\׃\\ \\ס","t":"beliYa'al","r":"ничтожество","s":"H1100"}]},{"number":12,"text":"Так говорит Господь: хотя они безопасны и многочисленны, но они будут посечены и исчезнут; а тебя, хотя Я отягощал, более не буду отягощать.","words":[{"o":"כֹּ֣ה\\׀","t":"koh","r":"так","s":"H3541"},{"o":"אָמַ֣ר","t":"'aMar","r":"он говорит","s":"H0559"},{"o":"יְהוָ֗ה","t":"Yahweh","r":"Яхве","s":"H3068"},{"o":"אִם\\־","t":"'im-","r":"фугх","s":"H0518"},{"o":"שְׁלֵמִים֙","t":"sheleMim","r":"завершённый","s":"H8003"},{"o":"וְכֵ֣ן","t":"veKhen","r":"и, так","s":"H9002"},{"o":"רַבִּ֔ים","t":"raBim","r":"многочисленный","s":"H7227"},{"o":"וְכֵ֥ן","t":"veKhen","r":"и, так","s":"H9002"},{"o":"נָגֹ֖זּוּ","t":"naGozu","r":"они будет быть отрезать вниз","s":"H1494"},{"o":"וְעָבָ֑ר","t":"ve'aVar","r":"и, он будет пройти прочь","s":"H9001"},{"o":"וְעִ֨נִּתִ֔ךְ","t":"ve'IniTikh","r":"и, я имеют угнетённый, ты","s":"H9001"},{"o":"לֹ֥א","t":"lo'","r":"не","s":"H3808"},{"o":"אֲעַנֵּ֖ךְ","t":"'a'aNekh","r":"я будет аффликт, ты","s":"H6031"},{"o":"עֽוֹד\\׃","t":"od","r":"снова","s":"H5750"}]},{"number":13,"text":"И ныне Я сокрушу ярмо его, лежащее на тебе, и узы твои разорву.","words":[{"o":"וְעַתָּ֕ה","t":"ve'aTah","r":"и, ныне","s":"H9002"},{"o":"אֶשְׁבֹּ֥ר","t":"'eshBor","r":"я будет разбить","s":"H7665"},{"o":"מֹטֵ֖הוּ","t":"moTehu","r":"йоке-бар, его","s":"H4132"},{"o":"מֵֽעָלָ֑יִךְ","t":"me'aLayikh","r":"от, на, ты","s":"H9006"},{"o":"וּמוֹסְרֹתַ֖יִךְ","t":"umosroTayikh","r":"и, феттерс, твой","s":"H9002"},{"o":"אֲנַתֵּֽק\\׃","t":"'anaTek","r":"я будет разодрать отдельно","s":"H5423"}]},{"number":14,"text":"А о тебе, Ассур, Господь определил: не будет более семени с твоим именем; из дома бога твоего истреблю истуканов и кумиров; приготовлю тебе в нем могилу, потому что ты будешь в презрении.","words":[{"o":"וְצִוָּ֤ה","t":"vetziVah","r":"и, он имеет повелел","s":"H9001"},{"o":"עָלֶ֙יךָ֙","t":"'aLeikha","r":"на, ты","s":"H5921"},{"o":"יְהוָ֔ה","t":"Yahweh","r":"Яхве","s":"H3068"},{"o":"לֹֽא\\־","t":"lo'-","r":"не","s":"H3808"},{"o":"יִזָּרַ֥ע","t":"yizaRa'","r":"оно будет быть посеянный","s":"H2232"},{"o":"מִשִּׁמְךָ֖","t":"mishimKha","r":"от, имя, твой","s":"H9006"},{"o":"ע֑וֹד","t":"od","r":"снова","s":"H5750"},{"o":"מִבֵּ֨ית","t":"miBeit","r":"от, дом","s":"H9006"},{"o":"אֱלֹהֶ֜יךָ","t":"'eloHeikha","r":"боги, твой","s":"H0430"},{"o":"אַכְרִ֨ית","t":"'akhRit","r":"я будет отрезать прочь","s":"H3772"},{"o":"פֶּ֧סֶל","t":"Pesel","r":"идол","s":"H6459"},{"o":"וּמַסֵּכָ֛ה","t":"umaseKhah","r":"и, литой образ","s":"H9002"},{"o":"אָשִׂ֥ים","t":"'aSim","r":"я будет делать","s":"H7760"},{"o":"קִבְרֶ֖ךָ","t":"kivRecha","r":"гроб, твой","s":"H6913"},{"o":"כִּ֥י","t":"ki","r":"для","s":"H3588"},{"o":"קַלּֽוֹתָ\\׃\\ \\פ","t":"kaLota","r":"ты есть инсигнификант","s":"H7043"}]}]},{"number":3,"verses":[{"number":1,"text":"Горе городу кровей! весь он полон обмана и убийства; не прекращается в нем грабительство.","words":[{"o":"ה֖וֹי","t":"Ho","r":"горе к!","s":"H1945"},{"o":"עִ֣יר","t":"'ir","r":"город","s":"H5892"},{"o":"דָּמִ֑ים","t":"daMim","r":"блуд<с>","s":"H1818"},{"o":"כֻּלָּ֗הּ","t":"kuLah","r":"все, оно","s":"H3605"},{"o":"כַּ֤חַשׁ","t":"Kachash","r":"лежащий","s":"H3585"},{"o":"פֶּ֙רֶק֙","t":"perek","r":"грабить","s":"H6563"},{"o":"מְלֵאָ֔ה","t":"mele'Ah","r":"есть полный","s":"H4392"},{"o":"לֹ֥א","t":"lo'","r":"не","s":"H3808"},{"o":"יָמִ֖ישׁ","t":"yaMish","r":"оно будет уйти","s":"H4185"},{"o":"טָֽרֶף\\׃","t":"Taref","r":"прей","s":"H2964"}]},{"number":2,"text":"Слышны хлопанье бича и стук крутящихся колес, ржание коня и грохот скачущей колесницы.","words":[{"o":"ק֣וֹל","t":"Kol","r":"звук","s":"H6963"},{"o":"שׁ֔וֹט","t":"Shot","r":"вхип","s":"H7752"},{"o":"וְק֖וֹל","t":"veKol","r":"и, звук","s":"H9002"},{"o":"רַ֣עַשׁ","t":"Ra'ash","r":"раттлинг","s":"H7494"},{"o":"אוֹפָ֑ן","t":"'oFan","r":"вхил","s":"H0212"},{"o":"וְס֣וּס","t":"veSus","r":"и, конь","s":"H9002"},{"o":"דֹּהֵ֔ר","t":"doHer","r":"галлопинг","s":"H1725"},{"o":"וּמֶרְכָּבָ֖ה","t":"umerkaVah","r":"и, колесница","s":"H9002"},{"o":"מְרַקֵּדָֽה\\׃","t":"merakeDah","r":"джолтинг","s":"H7540"}]},{"number":3,"text":"Несется конница, сверкает меч и блестят копья; убитых множество и груды трупов: нет конца трупам, спотыкаются о трупы их.","words":[{"o":"פָּרָ֣שׁ","t":"paRash","r":"всадник","s":"H6571"},{"o":"מַעֲלֶ֗ה","t":"ma'aLeh","r":"принося вверх","s":"H5927"},{"o":"וְלַ֤הַב","t":"veLahav","r":"и, бладе","s":"H9002"},{"o":"חֶ֙רֶב֙","t":"cherev","r":"меч","s":"H2719"},{"o":"וּבְרַ֣ק","t":"uveRak","r":"и, флаш","s":"H9002"},{"o":"חֲנִ֔ית","t":"chaNit","r":"копьё","s":"H2595"},{"o":"וְרֹ֥ב","t":"veRo","r":"и, множество","s":"H9002"},{"o":"חָלָ֖ל","t":"chaLal","r":"убитый","s":"H2491"},{"o":"וְכֹ֣בֶד","t":"veKhoed","r":"и, вес","s":"H9002"},{"o":"פָּ֑גֶר","t":"Pager","r":"трупы","s":"H6297"},{"o":"וְאֵ֥ין","t":"ve'Ein","r":"и, там не","s":"H9002"},{"o":"קֵ֙צֶה֙","t":"ketzeh","r":"есть конец","s":"H7097"},{"o":"לַגְּוִיָּ֔ה","t":"lageviYah","r":"к, тела","s":"H9005"},{"o":"וְכָשְׁל֖וּ","t":"veyikhshelu","r":"и, народ будет споткнуться","s":"H9001"},{"o":"בִּגְוִיָּתָֽם\\׃","t":"bigviyaTam","r":"над, тела, их","s":"H9003"}]},{"number":4,"text":"Это - за многие блудодеяния развратницы приятной наружности, искусной в чародеянии, которая блудодеяниями своими продает народы и чарованиями своими - племена.","words":[{"o":"מֵרֹב֙","t":"meRo","r":"от, изобилие","s":"H9006"},{"o":"זְנוּנֵ֣י","t":"zenuNei","r":"блуд","s":"H2183"},{"o":"זוֹנָ֔ה","t":"zoNah","r":"блудница","s":"H2181"},{"o":"ט֥וֹבַת","t":"Toat","r":"хороший","s":"H2896"},{"o":"חֵ֖ן","t":"chen","r":"благодать","s":"H2580"},{"o":"בַּעֲלַ֣ת","t":"ba'aLat","r":"мистресс","s":"H1172"},{"o":"כְּשָׁפִ֑ים","t":"keshaFim","r":"соркериес","s":"H3785"},{"o":"הַמֹּכֶ֤רֶת","t":"hamoKheret","r":"кто, селлс","s":"H9009"},{"o":"גּוֹיִם֙","t":"goYim","r":"народы","s":"H1471"},{"o":"בִּזְנוּנֶ֔יהָ","t":"biznuNeiha","r":"через, проститутион<с>, её","s":"H9003"},{"o":"וּמִשְׁפָּח֖וֹת","t":"umishpaChot","r":"и, роды","s":"H9002"},{"o":"בִּכְשָׁפֶֽיהָ\\׃","t":"bikhshaFeiha","r":"через, соркериес, её","s":"H9003"}]},{"number":5,"text":"Вот, Я - на тебя! говорит Господь Саваоф. И подниму на лице твое края одежды твоей и покажу народам наготу твою и царствам срамоту твою.","words":[{"o":"הִנְנִ֣י","t":"hiNi","r":"здесь, я","s":"H2005"},{"o":"אֵלַ֗יִךְ","t":"'eLayikh","r":"есмь против, ты","s":"H0413"},{"o":"נְאֻם֙","t":"ne'Um","r":"изречение","s":"H5002"},{"o":"יְהוָ֣ה","t":"Yahweh","r":"Яхве","s":"H3068"},{"o":"צְבָא֔וֹת","t":"tzeva'ot","r":"воинств","s":"H6635"},{"o":"וְגִלֵּיתִ֥י","t":"vegileiTi","r":"и, я будет открыть","s":"H9001"},{"o":"שׁוּלַ֖יִךְ","t":"shuLayikh","r":"скирц, твой","s":"H7757"},{"o":"עַל\\־","t":"'al-","r":"на","s":"H5921"},{"o":"פָּנָ֑יִךְ","t":"paNayikh","r":"лицо, твой","s":"H6440"},{"o":"וְהַרְאֵיתִ֤י","t":"vehar'eiTi","r":"и, я будет показать","s":"H9001"},{"o":"גוֹיִם֙","t":"goYim","r":"народы","s":"H1471"},{"o":"מַעְרֵ֔ךְ","t":"ma'Rekh","r":"нагота, твой","s":"H4626"},{"o":"וּמַמְלָכ֖וֹת","t":"umamlaKhot","r":"и, царства","s":"H9002"},{"o":"קְלוֹנֵֽךְ\\׃","t":"keloNekh","r":"стыд, твой","s":"H7036"}]},{"number":6,"text":"И забросаю тебя мерзостями, сделаю тебя презренною и выставлю тебя на позор.","words":[{"o":"וְהִשְׁלַכְתִּ֥י","t":"vehishlakhTi","r":"и, я будет бросить","s":"H9001"},{"o":"עָלַ֛יִךְ","t":"'aLayikh","r":"на, ты","s":"H5921"},{"o":"שִׁקֻּצִ֖ים","t":"shikuTzim","r":"мерзкий вещи","s":"H8251"},{"o":"וְנִבַּלְתִּ֑יךְ","t":"venibalTikh","r":"и, И вилл треат виф контемпт, ты","s":"H9001"},{"o":"וְשַׂמְתִּ֖יךְ","t":"vesamTikh","r":"и, я будет делать, ты","s":"H9001"},{"o":"כְּרֹֽאִי\\׃","t":"keRo'i","r":"как, спектакле","s":"H9004"}]},{"number":7,"text":"И будет то, что всякий, увидев тебя, побежит от тебя и скажет: \"разорена Ниневия! Кто пожалеет о ней? где найду я утешителей для тебя?\"","words":[{"o":"וְהָיָ֤ה","t":"vehaYah","r":"и будет","s":"H9001"},{"o":"כָל\\־","t":"khol-","r":"все","s":"H3605"},{"o":"רֹאַ֙יִךְ֙","t":"ro'Ayikh","r":"те кто видеть, ты","s":"H7200"},{"o":"יִדּ֣וֹד","t":"yiDod","r":"он будет бежать","s":"H5074"},{"o":"מִמֵּ֔ךְ","t":"miMekh","r":"от, ты","s":"H4480"},{"o":"וְאָמַר֙","t":"ve'aMar","r":"и, он будет сказать","s":"H9001"},{"o":"שָׁדְּדָ֣ה","t":"shadeDah","r":"оно есть девастатед","s":"H7703"},{"o":"נִֽינְוֵ֔ה","t":"ninVeh","r":"Ниневех","s":"H5210"},{"o":"מִ֖י","t":"mi","r":"кто?","s":"H4310"},{"o":"יָנ֣וּד","t":"yaNud","r":"будет он показать сймпафй","s":"H5110"},{"o":"לָ֑הּ","t":"Lah","r":"к, оно","s":"H9005"},{"o":"מֵאַ֛יִן","t":"me'Ayin","r":"от, где?","s":"H9006"},{"o":"אֲבַקֵּ֥שׁ","t":"'avaKesh","r":"будет я искать","s":"H1245"},{"o":"מְנַחֲמִ֖ים","t":"menachaMim","r":"комфортерс","s":"H5162"},{"o":"לָֽךְ\\׃","t":"Lakh","r":"для, ты","s":"H9005"}]},{"number":8,"text":"Разве ты лучше Но-Аммона, находящегося между реками, окруженного водою, которого вал было море, и море служило стеною его?","words":[{"o":"הֲתֵֽיטְבִי֙","t":"hateiteVi","r":"¿, имеют ты был сделал хороший","s":"H9008"},{"o":"מִנֹּ֣א","t":"miNo'","r":"более чем, Нет","s":"H9006"},{"o":"אָמ֔וֹן","t":"'aMon","r":"Амон","s":"H0528"},{"o":"הַיֹּֽשְׁבָה֙","t":"haiyosheVah","r":"что, был обитающий","s":"H9009"},{"o":"בַּיְאֹרִ֔ים","t":"bay'oRim","r":"среди, каналс","s":"H9003"},{"o":"מַ֖יִם","t":"Mayim","r":"вода","s":"H4325"},{"o":"סָבִ֣יב","t":"saViv","r":"был все вокруг","s":"H5439"},{"o":"לָ֑הּ","t":"Lah","r":"к, оно","s":"H9005"},{"o":"אֲשֶׁר\\־","t":"'aSher-","r":"который","s":"H0834"},{"o":"חֵ֣יל","t":"cheil","r":"рампарт","s":"H2426"},{"o":"יָ֔ם","t":"Yam","r":"был море","s":"H3220"},{"o":"מִיָּ֖ם","t":"miYam","r":"был от, море","s":"H9006"},{"o":"חוֹמָתָֽהּ\\׃","t":"chomaTah","r":"стена, его","s":"H2346"}]},{"number":9,"text":"Ефиопия и Египет с бесчисленным множеством других служили ему подкреплением; Копты и Ливийцы приходили на помощь тебе.","words":[{"o":"כּ֥וּשׁ","t":"kush","r":"Куш","s":"H3568"},{"o":"עָצְמָ֛ה","t":"'atzeMah","r":"был сила, его","s":"H6109"},{"o":"וּמִצְרַ֖יִם","t":"umitzRayim","r":"и, Египет","s":"H9002"},{"o":"וְאֵ֣ין","t":"ve'Ein","r":"и, там не","s":"H9002"},{"o":"קֵ֑צֶה","t":"Ketzeh","r":"был конец","s":"H7097"},{"o":"פּ֣וּט","t":"put","r":"Положить","s":"H6316"},{"o":"וְלוּבִ֔ים","t":"veluVim","r":"и, Либйанс","s":"H9002"},{"o":"הָי֖וּ","t":"haYu","r":"они были","s":"H1961"},{"o":"בְּעֶזְרָתֵֽךְ\\׃","t":"be'ezraTekh","r":"в, помочь, твой","s":"H9003"}]},{"number":10,"text":"Но и он переселен, пошел в плен; даже и младенцы его разбиты на перекрестках всех улиц, а о знатных его бросали жребий, и все вельможи его окованы цепями.","words":[{"o":"גַּם\\־","t":"gam-","r":"также","s":"H1571"},{"o":"הִ֗יא","t":"Hi'","r":"оно","s":"H1931"},{"o":"לַגֹּלָה֙","t":"lagoLah","r":"к, изгнание","s":"H9005"},{"o":"הָלְכָ֣ה","t":"haleKhah","r":"оно пошёл","s":"H1980"},{"o":"בַשֶּׁ֔בִי","t":"vaShevi","r":"в, плен","s":"H9003"},{"o":"גַּ֧ם","t":"gam","r":"также","s":"H1571"},{"o":"עֹלָלֶ֛יהָ","t":"'olaLeiha","r":"дети, его","s":"H5768"},{"o":"יְרֻטְּשׁ֖וּ","t":"yeruteShu","r":"они были дашед в куски","s":"H7376"},{"o":"בְּרֹ֣אשׁ","t":"beRosh","r":"у, голова","s":"H9003"},{"o":"כָּל\\־","t":"kol-","r":"все","s":"H3605"},{"o":"חוּצ֑וֹת","t":"chuTzot","r":"улицы","s":"H2351"},{"o":"וְעַל\\־","t":"ve'al-","r":"и, на","s":"H9002"},{"o":"נִכְבַּדֶּ֙יהָ֙","t":"nikhbaDeiha","r":"почтенный народ, его","s":"H3513"},{"o":"יַדּ֣וּ","t":"yaDu","r":"они бросить","s":"H3032"},{"o":"גוֹרָ֔ל","t":"goRal","r":"жребий","s":"H1486"},{"o":"וְכָל\\־","t":"vekhol","r":"и, все","s":"H9002"},{"o":"גְּדוֹלֶ֖יהָ","t":"gedoLeiha","r":"великий народ, его","s":"H1419"},{"o":"רֻתְּק֥וּ","t":"ruteKu","r":"они были связанный","s":"H7576"},{"o":"בַזִּקִּֽים\\׃","t":"vaziKim","r":"с, феттерс","s":"H9003"}]},{"number":11,"text":"Так и ты - опьянеешь и скроешься; так и ты будешь искать защиты от неприятеля.","words":[{"o":"גַּם\\־","t":"gam-","r":"также","s":"H1571"},{"o":"אַ֣תְּ","t":"'at","r":"ты","s":"H0859"},{"o":"תִּשְׁכְּרִ֔י","t":"tishkeRi","r":"ты будет стать выпитый","s":"H7937"},{"o":"תְּהִ֖י","t":"teHi","r":"будет","s":"H1961"},{"o":"נַֽעֲלָמָ֑ה","t":"na'alaMah","r":"скрытый","s":"H5956"},{"o":"גַּם\\־","t":"gam-","r":"также","s":"H1571"},{"o":"אַ֛תְּ","t":"'at","r":"ты","s":"H0859"},{"o":"תְּבַקְשִׁ֥י","t":"tevakShi","r":"ты будет искать","s":"H1245"},{"o":"מָע֖וֹז","t":"ma'oz","r":"убежище","s":"H4581"},{"o":"מֵאוֹיֵֽב\\׃","t":"me'oYev","r":"от, враг","s":"H9006"}]},{"number":12,"text":"Все укрепления твои подобны смоковнице со спелыми плодами: если тряхнуть их, то они упадут прямо в рот желающего есть.","words":[{"o":"כָּ֨ל\\־","t":"Kal-","r":"все","s":"H3605"},{"o":"מִבְצָרַ֔יִךְ","t":"mivtzaRayikh","r":"фортификатионс, твой","s":"H4013"},{"o":"תְּאֵנִ֖ים","t":"te'eNim","r":"есть смоква деревья","s":"H8384"},{"o":"עִם\\־","t":"'im-","r":"с","s":"H5973"},{"o":"בִּכּוּרִ֑ים","t":"bikuRim","r":"фирст-фруиц","s":"H1061"},{"o":"אִם\\־","t":"'im-","r":"если","s":"H0518"},{"o":"יִנּ֕וֹעוּ","t":"yiNo'u","r":"они будет быть потрясённый","s":"H5128"},{"o":"וְנָפְל֖וּ","t":"venafeLu","r":"и, они будет упасть","s":"H9001"},{"o":"עַל\\־","t":"'al-","r":"на","s":"H5921"},{"o":"פִּ֥י","t":"pi","r":"уста","s":"H6310"},{"o":"אוֹכֵֽל\\׃","t":"'oKhel","r":"еатер","s":"H0398"}]},{"number":13,"text":"Вот, и народ твой, как женщины у тебя: врагам твоим настежь отворятся ворота земли твоей, огонь пожрет запоры твои.","words":[{"o":"הִנֵּ֨ה","t":"hiNeh","r":"вот!","s":"H2009"},{"o":"עַמֵּ֤ךְ","t":"'aMekh","r":"народ, твой","s":"H5971"},{"o":"נָשִׁים֙","t":"naShim","r":"есть женщины","s":"H0802"},{"o":"בְּקִרְבֵּ֔ךְ","t":"bekirBekh","r":"в, среда, твой","s":"H9003"},{"o":"לְאֹ֣יְבַ֔יִךְ","t":"le'OyeVayikh","r":"к, враги, твой","s":"H9005"},{"o":"פָּת֥וֹחַ","t":"paToach","r":"непременно к открыть","s":"H6605"},{"o":"נִפְתְּח֖וּ","t":"nifteChu","r":"они будет быть открыл","s":"H6605"},{"o":"שַׁעֲרֵ֣י","t":"sha'aRei","r":"ворота","s":"H8179"},{"o":"אַרְצֵ֑ךְ","t":"'arTzekh","r":"земля, твой","s":"H0776"},{"o":"אָכְלָ֥ה","t":"'akheLah","r":"оно будет поглотить","s":"H0398"},{"o":"אֵ֖שׁ","t":"'esh","r":"огонь","s":"H0784"},{"o":"בְּרִיחָֽיִך\\׃","t":"beriChayikh","r":"засовы, твой","s":"H1280"}]},{"number":14,"text":"Начерпай воды на время осады; укрепляй крепости твои; пойди в грязь, топчи глину, исправь печь для обжигания кирпичей.","words":[{"o":"מֵ֤י","t":"mei","r":"вода","s":"H4325"},{"o":"מָצוֹר֙","t":"matzOr","r":"осада","s":"H4692"},{"o":"שַֽׁאֲבִי\\־","t":"sha'avi-","r":"тянуть","s":"H7579"},{"o":"לָ֔ךְ","t":"Lakh","r":"для, себя","s":"H9005"},{"o":"חַזְּקִ֖י","t":"chazeKi","r":"стренгфен","s":"H2388"},{"o":"מִבְצָרָ֑יִךְ","t":"mivtzaRayikh","r":"фортификатионс, твой","s":"H4013"},{"o":"בֹּ֧אִי","t":"Bo'i","r":"идти","s":"H0935"},{"o":"בַטִּ֛יט","t":"vaTit","r":"в, глина","s":"H9003"},{"o":"וְרִמְסִ֥י","t":"verimSi","r":"и, трампле","s":"H9002"},{"o":"בַחֹ֖מֶר","t":"vaChomer","r":"на, мортар","s":"H9003"},{"o":"הַחֲזִ֥יקִי","t":"hachaZiki","r":"взять держать","s":"H2388"},{"o":"מַלְבֵּֽן\\׃","t":"malBen","r":"брикк молд","s":"H4404"}]},{"number":15,"text":"Там пожрет тебя огонь, посечет тебя меч, поест тебя как гусеница, хотя бы ты умножился как гусеница, умножился как саранча.","words":[{"o":"שָׁ֚ם","t":"Sham","r":"там","s":"H8033"},{"o":"תֹּאכְלֵ֣ךְ","t":"tokheLekh","r":"оно будет поглотить, ты","s":"H0398"},{"o":"אֵ֔שׁ","t":"'Esh","r":"огонь","s":"H0784"},{"o":"תַּכְרִיתֵ֣ךְ","t":"takhriTekh","r":"оно будет отрезать прочь, ты","s":"H3772"},{"o":"חֶ֔רֶב","t":"Cherev","r":"меч","s":"H2719"},{"o":"תֹּאכְלֵ֖ךְ","t":"tokheLekh","r":"оно будет поглотить, ты","s":"H0398"},{"o":"כַּיָּ֑לֶק","t":"kaiYalek","r":"как, локуст","s":"H9004"},{"o":"הִתְכַּבֵּ֣ד","t":"hitkaBed","r":"делать себя многочисленный","s":"H3513"},{"o":"כַּיֶּ֔לֶק","t":"kaiYelek","r":"как, локуст","s":"H9004"},{"o":"הִֽתְכַּבְּדִ֖י","t":"hitkabeDi","r":"делать себя многочисленный","s":"H3513"},{"o":"כָּאַרְבֶּֽה\\׃","t":"ka'arBeh","r":"как, локуст","s":"H9004"}]},{"number":16,"text":"Купцов у тебя стало более, нежели звезд на небе; но эта саранча рассеется и улетит.","words":[{"o":"הִרְבֵּית֙","t":"hirBeit","r":"ты имеют увеличил","s":"H7235"},{"o":"רֹֽכְלַ֔יִךְ","t":"rokheLayikh","r":"традерс, твой","s":"H7402"},{"o":"מִכּוֹכְבֵ֖י","t":"mikokhVei","r":"более чем, звёзды","s":"H9006"},{"o":"הַשָּׁמָ֑יִם","t":"hashaMayim","r":"небеса","s":"H9009"},{"o":"יֶ֥לֶק","t":"Yelek","r":"локуст","s":"H3218"},{"o":"פָּשַׁ֖ט","t":"paShat","r":"оно стрипс прочь","s":"H6584"},{"o":"וַיָּעֹֽף\\׃","t":"vaiya'Of","r":"и, оно флев прочь","s":"H9001"}]},{"number":17,"text":"Князья твои - как саранча, и военачальники твои - как рои мошек, которые во время холода гнездятся в щелях стен, и когда взойдет солнце, то разлетаются, и не узнаешь места, где они были.","words":[{"o":"מִנְּזָרַ֙יִךְ֙","t":"minezaRayikh","r":"куртиерс, твой","s":"H4502"},{"o":"כָּֽאַרְבֶּ֔ה","t":"ka'arBeh","r":"есть как, локуст","s":"H9004"},{"o":"וְטַפְסְרַ֖יִךְ","t":"vetafseRayikh","r":"и, сановники, твой","s":"H9002"},{"o":"כְּג֣וֹב","t":"keGov","r":"есть как, локуст","s":"H9004"},{"o":"גֹּבָ֑י","t":"goyAi","r":"саранча","s":"H1462"},{"o":"הַֽחוֹנִ֤ים","t":"hachoNim","r":"который, расположиться станом","s":"H9009"},{"o":"בַּגְּדֵרוֹת֙","t":"bagederOt","r":"в, стены","s":"H9003"},{"o":"בְּי֣וֹם","t":"beYom","r":"на, день","s":"H9003"},{"o":"קָרָ֔ה","t":"kaRah","r":"колднесс","s":"H7135"},{"o":"שֶׁ֤מֶשׁ","t":"Shemesh","r":"солнце","s":"H8121"},{"o":"זָֽרְחָה֙","t":"zareChah","r":"оно встать","s":"H2224"},{"o":"וְנוֹדַ֔ד","t":"venoDad","r":"и, оно бежать","s":"H9002"},{"o":"וְלֹֽא\\־","t":"velo'-","r":"и, не","s":"H9002"},{"o":"נוֹדַ֥ע","t":"noDa'","r":"оно есть известный","s":"H3045"},{"o":"מְקוֹמ֖וֹ","t":"mekoMo","r":"место, его","s":"H4725"},{"o":"אַיָּֽם\\׃","t":"'aiYam","r":"где есть?, они","s":"H0335"}]},{"number":18,"text":"Спят пастыри твои, царь Ассирийский, покоятся вельможи твои; народ твой рассеялся по горам, и некому собрать его.","words":[{"o":"נָמ֤וּ","t":"naMu","r":"они есть слумберинг","s":"H5123"},{"o":"רֹעֶ֙יךָ֙","t":"ro'Eikha","r":"пастыри, твой","s":"H7462"},{"o":"מֶ֣לֶךְ","t":"Melekh","r":"О царь","s":"H4428"},{"o":"אַשּׁ֔וּר","t":"'aShur","r":"Ассирия","s":"H0804"},{"o":"יִשְׁכְּנ֖וּ","t":"yishkeNu","r":"они поселиться вниз","s":"H7931"},{"o":"אַדִּירֶ֑יךָ","t":"'adiReikha","r":"ноблес, твой","s":"H0117"},{"o":"נָפֹ֧שׁוּ","t":"naFoshu","r":"они есть рассеянный","s":"H6335"},{"o":"עַמְּךָ֛","t":"'ameKha","r":"народ, твой","s":"H5971"},{"o":"עַל\\־","t":"'al-","r":"на","s":"H5921"},{"o":"הֶהָרִ֖ים","t":"hehaRim","r":"горы","s":"H9009"},{"o":"וְאֵ֥ין","t":"ve'Ein","r":"и, там не","s":"H9002"},{"o":"מְקַבֵּֽץ\\׃","t":"mekaBetz","r":"есть один кто собирать их","s":"H6908"}]},{"number":19,"text":"Нет врачевства для раны твоей, болезненна язва твоя. Все, услышавшие весть о тебе, будут рукоплескать о тебе, ибо на кого не простиралась беспрестанно злоба твоя?","words":[{"o":"אֵין\\־","t":"'ein-","r":"там не","s":"H0369"},{"o":"כֵּהָ֣ה","t":"keHah","r":"есть релиеф","s":"H3545"},{"o":"לְשִׁבְרֶ֔ךָ","t":"leshivRekha","r":"для, фрактуре, твой","s":"H9005"},{"o":"נַחְלָ֖ה","t":"nachLah","r":"есть севере","s":"H2470"},{"o":"מַכָּתֶ֑ךָ","t":"makaTekha","r":"вунд, твой","s":"H4347"},{"o":"כֹּ֣ל\\׀","t":"kol","r":"все","s":"H3605"},{"o":"שֹׁמְעֵ֣י","t":"shome'Ei","r":"те кто слышать","s":"H8085"},{"o":"שִׁמְעֲךָ֗","t":"shim'aKha","r":"весть, твой","s":"H8088"},{"o":"תָּ֤קְעוּ","t":"Take'u","r":"они ударить","s":"H8628"},{"o":"כַף֙","t":"khaf","r":"ладонь","s":"H3709"},{"o":"עָלֶ֔יךָ","t":"'aLeikha","r":"н