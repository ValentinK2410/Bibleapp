{"translation":"PODSTR","book":{"id":"haggai","name":"Аггей","chapters":[{"number":1,"verses":[{"number":1,"text":"Во второй год царя Дария, в шестой месяц, в первый день месяца, было слово Господне через Аггея пророка к Зоровавелю, сыну Салафиилеву, правителю Иудеи, и к Иисусу, сыну Иоседекову, великому иерею:","words":[{"o":"בִּשְׁנַ֤ת","t":"bishNat","r":"в, год","s":"H9003"},{"o":"שְׁתַּ֙יִם֙","t":"sheTayim","r":"два","s":"H8147"},{"o":"לְדָרְיָ֣וֶשׁ","t":"ledareYavesh","r":"Дариус","s":"H9005"},{"o":"הַמֶּ֔לֶךְ","t":"haMelekh","r":"царь","s":"H9009"},{"o":"בַּחֹ֙דֶשׁ֙","t":"baChodesh","r":"в, месяц","s":"H9003"},{"o":"הַשִּׁשִּׁ֔י","t":"hashiShi","r":"шестой","s":"H9009"},{"o":"בְּי֥וֹם","t":"beYom","r":"на, день","s":"H9003"},{"o":"אֶחָ֖ד","t":"'eChad","r":"один","s":"H0259"},{"o":"לַחֹ֑דֶשׁ","t":"laChodesh","r":"месяц","s":"H9005"},{"o":"הָיָ֨ה","t":"haYah","r":"оно пришёл","s":"H1961"},{"o":"דְבַר\\־","t":"devar-","r":"слово","s":"H1697"},{"o":"יְהוָ֜ה","t":"Yahweh","r":"Яхве","s":"H3068"},{"o":"בְּיַד\\־","t":"beyad-","r":"через, рука","s":"H9003"},{"o":"חַגַּ֣י","t":"chaGai","r":"Аггей","s":"H2292"},{"o":"הַנָּבִ֗יא","t":"hanaVi'","r":"пророк","s":"H9009"},{"o":"אֶל\\־","t":"'el-","r":"к","s":"H0413"},{"o":"זְרֻבָּבֶ֤ל","t":"zerubaVel","r":"Зеруббабел","s":"H2216"},{"o":"בֶּן\\־","t":"ben-","r":"сын","s":"H1121"},{"o":"שְׁאַלְתִּיאֵל֙","t":"she'alti'El","r":"Шеалтиел","s":"H7597"},{"o":"פַּחַ֣ת","t":"paChat","r":"правитель","s":"H6346"},{"o":"יְהוּדָ֔ה","t":"yehuDah","r":"Иуда","s":"H3063"},{"o":"וְאֶל\\־","t":"ve'el-","r":"и, к","s":"H9002"},{"o":"יְהוֹשֻׁ֧עַ","t":"yehoShua'","r":"Иисус Навин","s":"H3091"},{"o":"בֶּן\\־","t":"ben-","r":"сын","s":"H1121"},{"o":"יְהוֹצָדָ֛ק","t":"yehotzaDak","r":"Джехозадак","s":"H3087"},{"o":"הַכֹּהֵ֥ן","t":"hakoHen","r":"священник","s":"H9009"},{"o":"הַגָּד֖וֹל","t":"hagaDol","r":"великий","s":"H9009"},{"o":"לֵאמֹֽר\\׃","t":"leMor","r":"к, говоря","s":"H9005"}]},{"number":2,"text":"так сказал Господь Саваоф: народ сей говорит: \"не пришло еще время, не время строить дом Господень\".","words":[{"o":"כֹּ֥ה","t":"koh","r":"так","s":"H3541"},{"o":"אָמַ֛ר","t":"'aMar","r":"он говорит","s":"H0559"},{"o":"יְהוָ֥ה","t":"Yahweh","r":"Яхве","s":"H3068"},{"o":"צְבָא֖וֹת","t":"tzeva'ot","r":"воинств","s":"H6635"},{"o":"לֵאמֹ֑ר","t":"leMor","r":"к, говоря","s":"H9005"},{"o":"הָעָ֤ם","t":"ha'Am","r":"народ","s":"H9009"},{"o":"הַזֶּה֙","t":"haZeh","r":"это","s":"H9009"},{"o":"אָֽמְר֔וּ","t":"'ameRu","r":"они имеют сказал","s":"H0559"},{"o":"לֹ֥א","t":"lo'","r":"не","s":"H3808"},{"o":"עֶת\\־","t":"'et-","r":"время","s":"H6256"},{"o":"בֹּ֛א","t":"bo'","r":"к прийти","s":"H0935"},{"o":"עֶת\\־","t":"'et-","r":"время","s":"H6256"},{"o":"בֵּ֥ית","t":"beit","r":"дом","s":"H1004"},{"o":"יְהוָ֖ה","t":"Yahweh","r":"Яхве","s":"H3068"},{"o":"לְהִבָּנֽוֹת\\׃\\ \\פ","t":"lehibaNot","r":"к, быть ребуилт","s":"H9005"}]},{"number":3,"text":"И было слово Господне через Аггея пророка:","words":[{"o":"וַֽיְהִי֙","t":"vayHi","r":"и, оно пришёл","s":"H9001"},{"o":"דְּבַר\\־","t":"devar-","r":"слово","s":"H1697"},{"o":"יְהוָ֔ה","t":"Yahweh","r":"Яхве","s":"H3068"},{"o":"בְּיַד\\־","t":"beyad-","r":"через, рука","s":"H9003"},{"o":"חַגַּ֥י","t":"chaGai","r":"Аггей","s":"H2292"},{"o":"הַנָּבִ֖יא","t":"hanaVi'","r":"пророк","s":"H9009"},{"o":"לֵאמֹֽר\\׃","t":"leMor","r":"к, говоря","s":"H9005"}]},{"number":4,"text":"а вам самим время жить в домах ваших украшенных, тогда как дом сей в запустении?","words":[{"o":"הַעֵ֤ת","t":"ha'Et","r":"¿, делает время","s":"H9008"},{"o":"לָכֶם֙","t":"laKhem","r":"принадлежать к, ты","s":"H9005"},{"o":"אַתֶּ֔ם","t":"'aTem","r":"ты","s":"H0859"},{"o":"לָשֶׁ֖בֶת","t":"laShevet","r":"к, обитать","s":"H9005"},{"o":"בְּבָתֵּיכֶ֣ם","t":"bevateiKhem","r":"в, дома, твой","s":"H9003"},{"o":"סְפוּנִ֑ים","t":"sefuNim","r":"покрыл","s":"H5603"},{"o":"וְהַבַּ֥יִת","t":"vehaBayit","r":"и, дом","s":"H9002"},{"o":"הַזֶּ֖ה","t":"haZeh","r":"это","s":"H9009"},{"o":"חָרֵֽב\\׃","t":"chaRev","r":"есть опустошённый","s":"H2720"}]},{"number":5,"text":"Посему ныне так говорит Господь Саваоф: обратите сердце ваше на пути ваши.","words":[{"o":"וְעַתָּ֕ה","t":"ve'aTah","r":"и, потому","s":"H9002"},{"o":"כֹּ֥ה","t":"koh","r":"так","s":"H3541"},{"o":"אָמַ֖ר","t":"'aMar","r":"он говорит","s":"H0559"},{"o":"יְהוָ֣ה","t":"Yahweh","r":"Яхве","s":"H3068"},{"o":"צְבָא֑וֹת","t":"tzeva'ot","r":"воинств","s":"H6635"},{"o":"שִׂ֥ימוּ","t":"Simu","r":"поставить","s":"H7760"},{"o":"לְבַבְכֶ֖ם","t":"levavKhem","r":"сердце, твой","s":"H3824"},{"o":"עַל\\־","t":"'al-","r":"на","s":"H5921"},{"o":"דַּרְכֵיכֶֽם\\׃","t":"darkheiKhem","r":"пути, твой","s":"H1870"}]},{"number":6,"text":"Вы сеете много, а собираете мало; едите, но не в сытость; пьете, но не напиваетесь; одеваетесь, а не согреваетесь; зарабатывающий плату зарабатывает для дырявого кошелька.","words":[{"o":"זְרַעְתֶּ֨ם","t":"zera'Tem","r":"ты имеют посеянный","s":"H2232"},{"o":"הַרְבֵּ֜ה","t":"harBeh","r":"много","s":"H7235"},{"o":"וְהָבֵ֣א","t":"vehaVe'","r":"и, ты имеют принёс","s":"H9002"},{"o":"מְעָ֗ט","t":"me'At","r":"малый","s":"H4592"},{"o":"אָכ֤וֹל","t":"'aKhol","r":"ты имеют съеденный","s":"H0398"},{"o":"וְאֵין\\־","t":"ve'ein-","r":"и, не","s":"H9002"},{"o":"לְשָׂבְעָה֙","t":"lesave'Ah","r":"к, сатиетй","s":"H9005"},{"o":"שָׁת֣וֹ","t":"shaTo","r":"ты имеют выпитый","s":"H8354"},{"o":"וְאֵין\\־","t":"ve'ein-","r":"и, не","s":"H9002"},{"o":"לְשָׁכְרָ֔ה","t":"leshakheRah","r":"к, стать выпитый","s":"H9005"},{"o":"לָב֖וֹשׁ","t":"laVoosh","r":"ты имеют дрессед","s":"H3847"},{"o":"וְאֵין\\־","t":"ve'ein-","r":"и, не","s":"H9002"},{"o":"לְחֹ֣ם","t":"leChom","r":"к, быть тёплый","s":"H9005"},{"o":"ל֑וֹ","t":"lo","r":"к, его","s":"H9005"},{"o":"וְהַ֨מִּשְׂתַּכֵּ֔ר","t":"veHammistaKer","r":"и, один кто еарнс плата","s":"H9002"},{"o":"מִשְׂתַּכֵּ֖ר","t":"mistaKer","r":"есть еарнинг плата","s":"H7936"},{"o":"אֶל\\־","t":"'el-","r":"к","s":"H0413"},{"o":"צְר֥וֹר","t":"tzeRor","r":"баг","s":"H6872"},{"o":"נָקֽוּב\\׃\\ \\פ","t":"naKuv","r":"пиеркед","s":"H5344"}]},{"number":7,"text":"Так говорит Господь Саваоф: обратите сердце ваше на пути ваши.","words":[{"o":"כֹּ֥ה","t":"koh","r":"так","s":"H3541"},{"o":"אָמַ֖ר","t":"'aMar","r":"он говорит","s":"H0559"},{"o":"יְהוָ֣ה","t":"Yahweh","r":"Яхве","s":"H3068"},{"o":"צְבָא֑וֹת","t":"tzeva'ot","r":"воинств","s":"H6635"},{"o":"שִׂ֥ימוּ","t":"Simu","r":"поставить","s":"H7760"},{"o":"לְבַבְכֶ֖ם","t":"levavKhem","r":"сердце, твой","s":"H3824"},{"o":"עַל\\־","t":"'al-","r":"на","s":"H5921"},{"o":"דַּרְכֵיכֶֽם\\׃","t":"darkheiKhem","r":"пути, твой","s":"H1870"}]},{"number":8,"text":"Взойдите на гору и носите дерева, и стройте храм; и Я буду благоволить к нему, и прославлюсь, говорит Господь.","words":[{"o":"עֲל֥וּ","t":"'aLu","r":"идти вверх","s":"H5927"},{"o":"הָהָ֛ר","t":"haHar","r":"холм страна","s":"H9009"},{"o":"וַהֲבֵאתֶ֥ם","t":"vahaveTem","r":"и, ты будет принести","s":"H9001"},{"o":"עֵ֖ץ","t":"'etz","r":"дерево","s":"H6086"},{"o":"וּבְנ֣וּ","t":"uveNu","r":"и, ребуилд","s":"H9002"},{"o":"הַבָּ֑יִת","t":"haBayit","r":"дом","s":"H9009"},{"o":"וְאֶרְצֶה\\־","t":"ve'ertzeh-","r":"так, я да взять удовольствие","s":"H9002"},{"o":"בּ֥וֹ","t":"bo","r":"в, оно","s":"H9003"},{"o":"וְאֶכָּבְדָ֖ה","t":"ve'ekaved","r":"так, позволить меня быть почтенный","s":"H9002"},{"o":"אָמַ֥ר","t":"'aMar","r":"он говорит","s":"H0559"},{"o":"יְהוָֽה\\׃","t":"Yahweh","r":"Яхве","s":"H3068"}]},{"number":9,"text":"Ожидаете многого, а выходит мало; и что принесете домой, то Я развею. - За что? говорит Господь Саваоф: за Мой дом, который в запустении, тогда как вы бежите, каждый к своему дому.","words":[{"o":"פָּנֹ֤ה","t":"paNoh","r":"ты повернул к смотри","s":"H6437"},{"o":"אֶל\\־","t":"'el-","r":"к","s":"H0413"},{"o":"הַרְבֵּה֙","t":"harBeh","r":"много","s":"H7235"},{"o":"וְהִנֵּ֣ה","t":"vehiNeh","r":"и, вот!","s":"H9002"},{"o":"לִמְעָ֔ט","t":"lim'At","r":"в, малый","s":"H9005"},{"o":"וַהֲבֵאתֶ֥ם","t":"vahaveTem","r":"и, ты принёс оно","s":"H9001"},{"o":"הַבַּ֖יִת","t":"haBayit","r":"дом"